nextflow_pipeline {

    name "Test pipeline by skipping QC options"
    script "../main.nf"
    tag "pipeline"

    test("Params: --skip_qc --min_mapped_reads 90") {

        when {
            params {
                outdir = "$outputDir"
                skip_qc = true
                min_mapped_reads = 90
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // WT_REP1 and WT_REP2 map at ~89%, the RAP1 samples above 90%.
            // Merged table contents are excluded from the snapshot by tests/.nftignore.
            def failed = ['WT_REP1', 'WT_REP2']
            def passed = ['RAP1_IAA_30M_REP1', 'RAP1_UNINDUCED_REP1', 'RAP1_UNINDUCED_REP2']
            def merged_samples = ['salmon.merged.gene_counts.tsv', 'salmon.merged.transcript_counts.tsv'].collect { name ->
                file("$outputDir/star_salmon/$name").readLines()[0].split('\t') as List
            }
            def fail_table = file("$outputDir/multiqc/star_salmon/multiqc_report_data/multiqc_fail_mapped_samples_table.txt").text
            assertAll(
                { assert workflow.success},
                { assert merged_samples.every { header -> failed.every { id -> !(id in header) } } },
                { assert merged_samples.every { header -> passed.every { id -> id in header } } },
                { assert failed.every { id -> fail_table.contains(id) } },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow and pipeline versions are removed (all from the workflow key)
                    removeFromYamlMap("$outputDir/pipeline_info/nf_core_rnaseq_software_mqc_versions.yml", "Workflow"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }

        cleanup {
            // Only prune/delete on CI - keeping local VM state intact prevents
            // cross-test launchDir wipes that break nf-test snapshot walks.
            if (System.getenv("CI") == "true") {
                if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                    "docker system prune -a -f --volumes".execute()
                }
                new File("${launchDir}").deleteDir()
            }
        }
    }

    test("Params: all samples below mapped reads threshold with de novo StringTie") {
        tag "stringtie_empty_merge"

        when {
            params {
                outdir = "$outputDir"
                skip_qc = true
                min_mapped_reads = 100
                stringtie_ignore_gtf = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().findAll { it.name.contains('STRINGTIE_STRINGTIE') }.isEmpty() },
                { assert workflow.trace.succeeded().findAll { it.name.contains('STRINGTIE_MERGE') }.isEmpty() }
            )
        }
    }

    test("Params: --skip_qc --min_mapped_reads 90 - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                skip_qc = true
                min_mapped_reads = 90
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow and pipeline versions are removed (all from the workflow key)
                    removeFromYamlMap("$outputDir/pipeline_info/nf_core_rnaseq_software_mqc_versions.yml", "Workflow"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }

        cleanup {
            // Only prune/delete on CI - keeping local VM state intact prevents
            // cross-test launchDir wipes that break nf-test snapshot walks.
            if (System.getenv("CI") == "true") {
                if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                    "docker system prune -a -f --volumes".execute()
                }
                new File("${launchDir}").deleteDir()
            }
        }
    }
}
