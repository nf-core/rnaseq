nextflow_process {

    name "Test Process SAMTOOLS_IDXSTATS"
    script "../main.nf"
    process "SAMTOOLS_IDXSTATS"
    tag "modules"
    tag "modules_nfcore"
    tag "samtools"
    tag "samtools/idxstats"

    test("bam") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out[0]
                ).match() }
            )
        }
    }

    test("bam - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out[0]
                ).match() }
            )
        }
    }
}
