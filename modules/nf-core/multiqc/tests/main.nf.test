    test("sarscov2 single-end [fastqc] [multiple configs]") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'FASTQC',
                    meta: [ id: 'FASTQC' ],
                    multiqc_files: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true),
                    multiqc_config: [
                        file("https:
                        file("https:
                    ],
                    multiqc_logo: [],
                    replace_names: [],
                    sample_names: []
                ))
                """
            }
        }

        then {
            assert process.success
            def mqc = process.out[0][0]
            assert snapshot(
                [
                    report: file(mqc.report).name,
                    data:   path(mqc.data).list().collect { file(it.toString()).name },
                    plots:  [
                        pdf: path("${mqc.plots}/pdf").list().collect { file(it.toString()).name },
