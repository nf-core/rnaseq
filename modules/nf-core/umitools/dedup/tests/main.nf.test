                    bam: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.single_end.umi.sorted.bam", checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.single_end.umi.sorted.bam.bai", checkIfExists: true)
                )
                input[1] = get_output_stats
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out[0][0].collectEntries { k, v -> [k, v == null ? null : v] }).match() }
            )
        }
    }

    test("pe - no stats - stub") {

        options "-stub"

        config "./nextflow.config"

        when {
            process {
                """
                get_output_stats = false

                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    bam: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam", checkIfExists: true),
