nextflow_process {

    name "Test Process RSEQC_READDUPLICATION"
    script "../main.nf"
    process "RSEQC_READDUPLICATION"
    tag "modules"
    tag "modules_nfcore"
    tag "rseqc"
    tag "rseqc/readduplication"

    test("sarscov2 paired-end [bam]") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end: false ],
                    bam: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam", checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai", checkIfExists: true)
                ))
                """
            }
        }

        then {
            def r = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(r.pdf).name,
                    r.meta,
                    r.pos_xls,
                    r.rscript,
                    r.seq_xls
                ).match() }
            )
        }
    }

    test("sarscov2 paired-end [bam] - stub") {

    options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end: false ],
                    bam: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam", checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai", checkIfExists: true)
                ))
                """
            }
        }

        then {
            def r = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert snapshot(r.meta, r.seq_xls, r.pos_xls, r.pdf, r.rscript).match() }
            )
        }
    }
}
