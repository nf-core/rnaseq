nextflow_process {

    name "Test Process DUPRADAR"
    script "../main.nf"
    process "DUPRADAR"

    tag "modules"
    tag "modules_nfcore"
    tag "dupradar"

    test("sarscov2 - bam - single_end") {

        config './nextflow.config'

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:true, strandedness:'forward' ],
                    bam: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.single_end.bam", checkIfExists: true)
                )
                input[1] = [
                    [ id:'sarscov2' ], // meta map
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gtf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def r = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(r.boxplot).name,
                    file(r.hist).name,
                    file(r.scatter2d).name,
                    r.meta,
                    r.dupmatrix,
                    r.intercept_slope,
                    r.multiqc
                ).match() },
            )
        }
    }

    test("sarscov2 - bam - single_end - stub") {

        config './nextflow.config'

        options '-stub'

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:true, strandedness:'forward' ],
                    bam: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.single_end.bam", checkIfExists: true)
                )
                input[1] = [
                    [ id:'sarscov2' ], // meta map
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gtf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def r = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert snapshot(r.meta, r.scatter2d, r.boxplot, r.hist, r.dupmatrix, r.intercept_slope, r.multiqc, r.session_info).match() }
            )
        }
    }

    test("sarscov2 - bam - paired_end") {

        config './nextflow.config'

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:false, strandedness:'forward' ],
                    bam: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.bam", checkIfExists: true)
                )
                input[1] = [
                    [ id:'sarscov2' ], // meta map
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gtf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def r = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(r.boxplot).name,
                    file(r.hist).name,
                    file(r.scatter2d).name,
                    r.meta,
                    r.dupmatrix,
                    r.intercept_slope,
                    r.multiqc
                ).match() },
            )
        }
    }

    test("sarscov2 - bam - paired_end - stub") {

        config './nextflow.config'

        options '-stub'

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:false, strandedness:'forward' ],
                    bam: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.bam", checkIfExists: true)
                )
                input[1] = [
                    [ id:'sarscov2' ], // meta map
                    file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gtf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def r = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert snapshot(r.meta, r.scatter2d, r.boxplot, r.hist, r.dupmatrix, r.intercept_slope, r.multiqc, r.session_info).match() }
            )
        }
    }
}
