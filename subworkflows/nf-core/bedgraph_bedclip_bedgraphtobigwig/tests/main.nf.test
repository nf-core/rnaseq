nextflow_workflow {

    name "Test Workflow BEDGRAPH_BEDCLIP_BEDGRAPHTOBIGWIG"
    script "../main.nf"
    workflow "BEDGRAPH_BEDCLIP_BEDGRAPHTOBIGWIG"
    config "./nextflow.config"
    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/bedgraph_bedclip_bedgraphtobigwig"
    tag "bedgraph_bedclip_bedgraphtobigwig"
    tag "ucsc"
    tag "ucsc/bedclip"
    tag "ucsc/bedgraphtobigwig"

    test("sarscov2 [bedgraph] [genome_sizes]") {

        when {
            workflow {
                """
                input[0] = new nextflow.dataflow.ChannelImpl(channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    bedgraph: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bedgraph/test.bedgraph', checkIfExists: true)
                )))
                input[1] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.sizes', checkIfExists: true)))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("sarscov2 [bedgraph] [genome_sizes] - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = new nextflow.dataflow.ChannelImpl(channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    bedgraph: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bedgraph/test.bedgraph', checkIfExists: true)
                )))
                input[1] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.sizes', checkIfExists: true)))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
