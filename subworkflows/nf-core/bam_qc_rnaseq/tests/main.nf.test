nextflow_workflow {

    name "Test Workflow BAM_QC_RNASEQ"
    script "../main.nf"
    workflow "BAM_QC_RNASEQ"
    config "./nextflow.config"
    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/bam_qc_rnaseq"
    tag "bam_qc_rnaseq"
    tag "preseq/lcextrap"
    tag "qualimap/rnaseq"
    tag "dupradar"
    tag "subread/featurecounts"
    tag "custom/multiqccustombiotype"
    tag "samtools/sort"
    tag "subworkflows/bam_rseqc"

    test("saccharomyces_cerevisiae paired-end [bam] - all modules") {

        when {
            workflow {
                """
                def biotypes_header = file("\${workDir}/biotypes_header.txt")
                biotypes_header.text = [
                    "# id: 'biotype_counts'",
                    "# section_name: 'Biotype Counts'",
                    "# description: 'shows reads overlapping genomic features of different biotypes'",
                    "# plot_type: 'bargraph'",
                    "# anchor: 'featurecounts_biotype'",
                ].join('\\n') + '\\n'

                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false, strandedness:'reverse' ],
                    bam: file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf', checkIfExists: true))
                input[2] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.bed12', checkIfExists: true))
                input[3] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome/genome.fa', checkIfExists: true))
                input[4] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome/genome.fa.fai', checkIfExists: true))
                input[5] = biotypes_header
                input[6] = ['preseq', 'biotype_qc', 'qualimap', 'dupradar', 'rseqc_bam_stat', 'rseqc_inner_distance', 'rseqc_infer_experiment', 'rseqc_junction_annotation', 'rseqc_junction_saturation', 'rseqc_read_distribution', 'rseqc_read_duplication', 'rseqc_tin']
                input[7] = 'gene_biotype'
                """
            }
        }

        then {
            def r = workflow.out[0][0]
            assertAll(
                { assert workflow.success },
                { assert r.qualimap != null },
                { assert !r.dupradar.multiqc.isEmpty() },
                { assert r.biotype.tsv != null },
                { assert r.biotype.rrna != null },
                { assert r.featurecounts.counts != null },
                { assert r.rseqc.bamstat != null },
                { assert r.rseqc.inferexperiment != null },
                { assert r.rseqc.readdistribution != null },
                { assert r.meta == [ id:'test', single_end:false, strandedness:'reverse' ] },
                { assert r.mqc_files.size() >= 12 },
                { assert snapshot(
                    r.dupradar.dupmatrix,
                    file(r.dupradar.intercept_slope).name, // Floating number unstable
                    r.dupradar.multiqc.collect { qcFile -> file(qcFile).name }, // Floating number unstable
                    r.rseqc.bamstat,
                    r.rseqc.inferexperiment,
                    r.rseqc.readdistribution,
                    r.rseqc.readduplication.pos_xls,
                ).match() }
            )
        }
    }

    test("saccharomyces_cerevisiae single-end [bam] - all modules") {
        tag "test2"
        when {
            workflow {
                """
                def biotypes_header = file("\${workDir}/biotypes_header.txt")
                biotypes_header.text = [
                    "# id: 'biotype_counts'",
                    "# section_name: 'Biotype Counts'",
                    "# description: 'shows reads overlapping genomic features of different biotypes'",
                    "# plot_type: 'bargraph'",
                    "# anchor: 'featurecounts_biotype'",
                ].join('\\n') + '\\n'

                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:true, strandedness:'reverse' ],
                    bam: file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/illumina/bam/test.single_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/illumina/bam/test.single_end.sorted.bam.bai', checkIfExists: true)
                ))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf', checkIfExists: true))
                input[2] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.bed12', checkIfExists: true))
                input[3] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome/genome.fa', checkIfExists: true))
                input[4] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome/genome.fa.fai', checkIfExists: true))
                input[5] = biotypes_header
                input[6] = ['preseq', 'biotype_qc', 'qualimap', 'dupradar', 'rseqc_bam_stat', 'rseqc_infer_experiment', 'rseqc_junction_annotation', 'rseqc_junction_saturation', 'rseqc_read_distribution', 'rseqc_read_duplication', 'rseqc_tin']
                input[7] = 'gene_biotype'
                """
            }
        }

        then {
            def r = workflow.out[0][0]
            assertAll(
                { assert workflow.success },
                { assert r.qualimap != null },
                { assert !r.dupradar.multiqc.isEmpty() },
                { assert r.biotype.tsv != null },
                { assert r.rseqc.bamstat != null },
                { assert r.rseqc.inferexperiment != null },
                { assert r.rseqc.readdistribution != null },
                { assert r.meta == [ id:'test', single_end:true, strandedness:'reverse' ] },
                // single-end drops rseqc_inner_distance
                { assert r.mqc_files.size() >= 11 },
                { assert snapshot(
                    r.dupradar.dupmatrix,
                    file(r.dupradar.intercept_slope).name, // Floating number unstable
                    r.dupradar.multiqc.collect { qcFile -> file(qcFile).name }, // Floating number unstable
                    r.rseqc.bamstat,
                    r.rseqc.inferexperiment,
                    r.rseqc.readdistribution,
                    r.rseqc.readduplication.pos_xls,
                    r.rseqc.tin.txt
                ).match() }
            )
        }
    }

    test("saccharomyces_cerevisiae paired-end [bam] - no tools enabled") {

        when {
            workflow {
                """
                def biotypes_header = file("\${workDir}/biotypes_header.txt")
                biotypes_header.text = '# stub'

                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false, strandedness:'reverse' ],
                    bam: file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf', checkIfExists: true))
                input[2] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.bed12', checkIfExists: true))
                input[3] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome/genome.fa', checkIfExists: true))
                input[4] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome/genome.fa.fai', checkIfExists: true))
                input[5] = biotypes_header
                input[6] = [] // tools - none enabled
                input[7] = '' // biotype
                """
            }
        }

        then {
            def r = workflow.out[0][0]
            assertAll(
                { assert workflow.success },
                { assert r.qualimap == null },
                { assert r.dupradar == null },
                { assert r.rseqc == null },
                { assert r.mqc_files.isEmpty() }
            )
        }
    }

    test("saccharomyces_cerevisiae paired-end [bam] - all modules - stub") {

        options "-stub"

        when {
            workflow {
                """
                def biotypes_header = file("\${workDir}/biotypes_header.txt")
                biotypes_header.text = '# stub'

                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false, strandedness:'reverse' ],
                    bam: file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf', checkIfExists: true))
                input[2] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.bed12', checkIfExists: true))
                input[3] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome/genome.fa', checkIfExists: true))
                input[4] = channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome/genome.fa.fai', checkIfExists: true))
                input[5] = biotypes_header
                input[6] = ['preseq', 'biotype_qc', 'qualimap', 'dupradar', 'rseqc_bam_stat', 'rseqc_inner_distance', 'rseqc_infer_experiment', 'rseqc_junction_annotation', 'rseqc_junction_saturation', 'rseqc_read_distribution', 'rseqc_read_duplication', 'rseqc_tin']
                input[7] = 'gene_biotype'
                """
            }
        }

        then {
            def r = workflow.out[0][0]
            assertAll(
                { assert workflow.success },
                { assert snapshot(r.mqc_files.collect { f -> file(f).name }.sort()).match() }
            )
        }
    }
}
