nextflow_process {

    name "Test Process DESEQ2_QC"
    script "../main.nf"
    process "DESEQ2_QC"

    test("parse count data correctly") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'all_samples',
                    meta: [ id:'all_samples' ],
                    counts: file(params.pipelines_testdata_base_path + "deseq2qc/countFile.tsv", checkIfExists: true)
                ))
                input[1] = file(params.pipelines_testdata_base_path + "deseq2qc/deseq2_pca_header.txt", checkIfExists: true)
                input[2] = file(params.pipelines_testdata_base_path + "deseq2qc/deseq2_clustering_header.txt", checkIfExists: true)
                """
            }
        }

        then {
            def deseq2 = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert path(deseq2.sample_dists).exists() },
                { assert path(deseq2.pca_vals).exists() },
                { assert snapshot(
                    deseq2.dists_multiqc,
                    deseq2.pca_multiqc
                ).match() }
            )
        }
    }

    test("parse count data correctly - stub") {

    options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'all_samples',
                    meta: [ id:'all_samples' ],
                    counts: file(params.pipelines_testdata_base_path + "deseq2qc/countFile.tsv", checkIfExists: true)
                ))
                input[1] = file(params.pipelines_testdata_base_path + "deseq2qc/deseq2_pca_header.txt", checkIfExists: true)
                input[2] = file(params.pipelines_testdata_base_path + "deseq2qc/deseq2_clustering_header.txt", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
