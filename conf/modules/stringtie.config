process {
    withName: 'STRINGTIE_STRINGTIE' {
        ext.args = {
            def strandedness = sample.meta.strandedness == 'forward' ? '--fr' :
                sample.meta.strandedness == 'reverse' ? '--rf' : ''
            [ strandedness, '-v' ].join(' ').trim()
        }
    }

    withName: '.*NFCORE_RNASEQ:RNASEQ:BAM_STRINGTIE_MERGE:STRINGTIE_STRINGTIE' {
        ext.prefix = { "${sample.meta.id}.denovo" }
    }

}
