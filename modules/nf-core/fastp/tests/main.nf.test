nextflow_process {

    name "Test Process FASTP"
    script "../main.nf"
    process "FASTP"
    tag "modules"
    tag "modules_nfcore"
    tag "fastp"

    test("test_fastp_single_end") {

        when {

            process {
                """
                adapter_fasta        = null
                discard_trimmed_pass = false
                save_trimmed_fail    = false
                save_merged          = false

                input[0] = Channel.of([
                    [ id:'test', single_end:true ],
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ],
                    adapter_fasta
                ])
                input[1] = discard_trimmed_pass
                input[2] = save_trimmed_fail
                input[3] = save_merged
                """
            }
        }

        then {
            def fp = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert path(fp.html).getText().contains("single end (151 cycles)") },
                { assert path(fp.log).getText().contains("reads passed filter: 99") },
                { assert snapshot(
                    fp.reads,
                    fp.reads_fail,
                    fp.reads_merged).match()
                }
            )
        }
    }

    test("test_fastp_paired_end") {

        when {

            process {
                """
                adapter_fasta        = null
                discard_trimmed_pass = false
                save_trimmed_fail    = false
                save_merged          = false

                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ],
                    adapter_fasta
                ])
                input[1] = discard_trimmed_pass
                input[2] = save_trimmed_fail
                input[3] = save_merged
                """
            }
        }

        then {
            def fp = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert path(fp.html).getText().contains("The input has little adapter percentage (~0.000000%), probably it's trimmed before.") },
                { assert path(fp.log).getText().contains("Q30 bases: 12281(88.3716%)") },
                { assert snapshot(
                    fp.reads,
                    fp.reads_fail,
                    fp.reads_merged).match() }
            )
        }
    }

    test("fastp test_fastp_interleaved") {

        config './nextflow.interleaved.config'
        when {
            process {
                """
                adapter_fasta        = null
                discard_trimmed_pass = false
                save_trimmed_fail    = false
                save_merged          = false

                input[0] = Channel.of([
                    [ id:'test', single_end:true ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_interleaved.fastq.gz', checkIfExists: true) ],
                    adapter_fasta
                ])
                input[1] = discard_trimmed_pass
                input[2] = save_trimmed_fail
                input[3] = save_merged
                """
            }
        }

        then {
            def fp = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert path(fp.html).getText().contains("paired end (151 cycles + 151 cycles)") },
                { assert path(fp.log).getText().contains("reads passed filter: 162") },
                { assert fp.reads_fail == [] },
                { assert fp.reads_merged == null },
                { assert snapshot(
                    fp.reads).match() }
            )
        }
    }

