//
// DESeq2 QC options
//

process {
    withName: 'DESEQ2_QC_(BAM_SALMON|RSEM)' {
        ext.args   = { [
            "--id_col 1",
            "--sample_suffix ''",
            "--count_col 3",
            params.deseq2_vst ? '--vst TRUE' : ''
        ].join(' ').trim() }
        ext.args2  = { params.aligner }
        publishDir = [ enabled: false ]
    }
}
