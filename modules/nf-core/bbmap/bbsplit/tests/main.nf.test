nextflow_process {

    name "Test Process BBMAP_BBSPLIT"
    script "../main.nf"
    process "BBMAP_BBSPLIT"
    tag "modules"
    tag "modules_nfcore"
    tag "bbmap"
    tag "bbmap/bbsplit"

    test("sarscov2_se_fastq_fasta_chr22_fasta - build index") {

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [:],
                    reads: []
                )
                input[1] = null
                input[2] = Channel.of(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true))
                input[3] = Channel.of([
                    [ 'human' ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/chr22_23800000-23980000.fa', checkIfExists: true) ]
                ])
                input[4] = true
                """
            }
        }

        then {
            def bb = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert path("${bb.index}").exists() },
                { assert path(bb.log).text.contains("No index available") }
            )
        }
    }

    test("sarscov2_se_fastq_fasta_chr22_fasta - build index - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [:],
                    reads: []
                )
                input[1] = null
                input[2] = Channel.of(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true))
                input[3] = Channel.of([
                    [ 'human' ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/chr22_23800000-23980000.fa', checkIfExists: true) ]
                ])
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.success }
            )
        }
    }

    test("sarscov2_se_fastq_fasta_chr22_fasta - split with prebuilt index") {

        setup {

            run("BBMAP_BBSPLIT", alias: "BBMAP_BBSPLIT_INDEX") {
                script "../main.nf"
                process {
                    """
                    input[0] = record(
                        id: 'test',
                        meta: [:],
                        reads: []
                    )
                    input[1] = null
                    input[2] = Channel.of(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true))
                    input[3] = Channel.of([
                        [ 'human' ], // meta map
                        [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/chr22_23800000-23980000.fa', checkIfExists: true) ]
                    ])
                    input[4] = true
                    """
                }
            }
        }

        when {
            process {
                    """
                    input[0] = Channel.of(record(
                        id: 'test',
                        meta: [ id:'test', single_end:true ],
                        reads: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                    ))
                    input[1] = BBMAP_BBSPLIT_INDEX.out.map { r -> r.index }
                    input[2] = null
                    input[3] = [[], []]
                    input[4] = false
                    """
                }
        }

        then {
            def bb = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert path(bb.log).text.contains("If you wish to regenerate the index") },
                { assert snapshot(
                    bb.reads,
                    bb.stats
                ).match()}
            )
        }
    }

    test("sarscov2_se_fastq_fasta_chr22_fasta - split with prebuilt index - stub") {

        options "-stub"

        setup {

            run("BBMAP_BBSPLIT", alias: "BBMAP_BBSPLIT_INDEX") {
                script "../main.nf"
                process {
                    """
                    input[0] = record(
                        id: 'test',
                        meta: [:],
                        reads: []
                    )
                    input[1] = null
                    input[2] = Channel.of(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true))
                    input[3] = Channel.of([
                        [ 'human' ], // meta map
                        [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/chr22_23800000-23980000.fa', checkIfExists: true) ]
                    ])
                    input[4] = true
                    """
                }
            }
        }

        when {
            process {
                """
                    input[0] = Channel.of(record(
                        id: 'test',
                        meta: [ id:'test', single_end:true ],
                        reads: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                    ))
                    input[1] = BBMAP_BBSPLIT_INDEX.out.map { r -> r.index }
                    input[2] = null
                    input[3] = [[], []]
                    input[4] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success }
            )
        }
    }
}
