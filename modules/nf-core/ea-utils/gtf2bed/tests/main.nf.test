nextflow_process {

    name "Test Process EAUTILS_GTF2BED"
    script "../main.nf"
    process "EAUTILS_GTF2BED"

    tag "modules"
    tag "modules_nfcore"
    tag "ea-utils"
    tag "ea-utils/gtf2bed"

    test("homo_sapiens - gtf") {

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test' ],
                    gtf: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out[0]).match() }
            )
        }

    }

    test("homo_sapiens - gtf - extended") {

        config "./nextflow.config"

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test' ],
                    gtf: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out[0]).match() }
            )
        }

    }

    test("homo_sapiens - gtf - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test' ],
                    gtf: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out[0]).match() }
            )
        }

    }

}
