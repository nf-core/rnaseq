nextflow_process {

    name "Test Process TRIMGALORE"
    script "../main.nf"
    process "TRIMGALORE"

    tag "modules"
    tag "modules_nfcore"
    tag "trimgalore"

    test("sarscov2 - fastq - single-end") {

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    reads: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                )
                """
            }
        }

        then {
            def tg = process.out[0][0]
            assertAll (
                { assert process.success },
                { assert snapshot(
                    tg.reads,
                    tg.json,
                    path(tg.log[0]).readLines().dropWhile { !it.startsWith("=== Summary") }.join('\n').md5()
                ).match() }
            )
        }
    }

    test("sarscov2 - fastq - paired-end") {

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    reads: [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            def tg = process.out[0][0]
            assertAll (
                { assert process.success },
                { assert snapshot(
                    tg.reads,
                    tg.json,
                    path(tg.log[0]).readLines().dropWhile { !it.startsWith("=== Summary") }.join('\n').md5(),
                    path(tg.log[1]).readLines().dropWhile { !it.startsWith("=== Summary") }.join('\n').md5()
                ).match() }
            )
        }
    }

    test("sarscov2 - fastq - paired-end - keep-unpaired") {

        config "./nextflow.config"

        when {
            params {
                module_args = '--retain_unpaired --length 150'
            }

            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    reads: [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            def tg = process.out[0][0]
            assertAll (
                { assert process.success },
                { assert snapshot(
                    tg.reads,
                    tg.unpaired,
                    tg.json,
                    path(tg.log[0]).readLines().dropWhile { !it.startsWith("=== Summary") }.join('\n').md5(),
                    path(tg.log[1]).readLines().dropWhile { !it.startsWith("=== Summary") }.join('\n').md5()
                ).match() }
            )
        }
    }

    test("sarscov2 - fastq - single-end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    reads: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                )
                """
            }
        }

        then {
            def tg = process.out[0][0]
            assertAll (
                { assert process.success },
                { assert snapshot(
                    tg.reads,
                    tg.log,
                    tg.json
                ).match() }
            )
        }
    }

    test("sarscov2 - fastq - paired-end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    reads: [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            def tg = process.out[0][0]
            assertAll (
                { assert process.success },
                { assert snapshot(
                    tg.reads,
                    tg.log,
                    tg.json
                ).match() }
            )
        }
    }
}
