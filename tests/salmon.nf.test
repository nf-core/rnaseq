    test("Params: --pseudo_aligner salmon, duplicate transcript dropped by default") {

        when {
            def duplicateFasta = File.createTempFile('transcriptome_with_duplicate', '.fasta')
            duplicateFasta.text = DUPLICATE_TRANSCRIPT_FASTA

            params {
                outdir = "$outputDir"
                pseudo_aligner = 'salmon'
                skip_qc = true
                skip_alignment = true
                salmon_index = null  // force a fresh build from transcript_fasta below, not conf/test.config's pre-built index
                additional_fasta = null  // transcript_fasta below cannot receive additional_fasta spike-ins (#1450)
                transcript_fasta = duplicateFasta.toString()
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // DUPLICATE_TX_FIXTURE is an exact-sequence duplicate of PRIMARY_TX; Salmon collapses
                // it out of the index by default, so it never reaches the merged matrix.
                { assert !file("$outputDir/salmon/salmon.merged.transcript_counts.tsv").text.contains('DUPLICATE_TX_FIXTURE') }
            )
        }

        cleanup {
            // Only prune/delete on CI - keeping local VM state intact prevents
            // cross-test launchDir wipes that break nf-test snapshot walks.
            if (System.getenv("CI") == "true") {
                if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                    "docker system prune -a -f --volumes".execute()
                }
                new File("${launchDir}").deleteDir()
            }
        }
    }

    test("Params: --pseudo_aligner salmon --extra_salmon_index_args --keepDuplicates retains the duplicate transcript") {

        when {
            def duplicateFasta = File.createTempFile('transcriptome_with_duplicate', '.fasta')
            duplicateFasta.text = DUPLICATE_TRANSCRIPT_FASTA

            params {
                outdir = "$outputDir"
                pseudo_aligner = 'salmon'
                skip_qc = true
                skip_alignment = true
                salmon_index = null  // force a fresh build from transcript_fasta below, not conf/test.config's pre-built index
                additional_fasta = null  // transcript_fasta below cannot receive additional_fasta spike-ins (#1450)
                transcript_fasta = duplicateFasta.toString()
                extra_salmon_index_args = '--keepDuplicates'
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Same fixture as the default-behaviour test above, but with --keepDuplicates passed
                // through extra_salmon_index_args: DUPLICATE_TX_FIXTURE is retained in the index and
                // shows up as its own row in the merged matrix.
                { assert file("$outputDir/salmon/salmon.merged.transcript_counts.tsv").text.contains('DUPLICATE_TX_FIXTURE') }
            )
        }

        cleanup {
            // Only prune/delete on CI - keeping local VM state intact prevents
            // cross-test launchDir wipes that break nf-test snapshot walks.
            if (System.getenv("CI") == "true") {
                if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                    "docker system prune -a -f --volumes".execute()
                }
                new File("${launchDir}").deleteDir()
            }
        }
    }
}
