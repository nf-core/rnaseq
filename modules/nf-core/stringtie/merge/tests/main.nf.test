nextflow_process {

    name "Test Process STRINGTIE_MERGE"
    script "../main.nf"
    process "STRINGTIE_MERGE"
    tag "modules"
    tag "modules_nfcore"
    tag "stringtie"
    tag "stringtie/merge"
    tag "stringtie/stringtie"

    setup {
        run("STRINGTIE_STRINGTIE") {
            script "../../stringtie/main.nf"
            process {
            """
            input[0] = record(
                id: 'test',
                meta: [ id:'test', strandedness:'reverse' ],
                bam: file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam", checkIfExists: true),
                lrbam: file(params.modules_testdata_base_path + "genomics/homo_sapiens/pacbio/bam/test_hifi_aligned_assembly.bam", checkIfExists: true)
            )
            input[1] = ["mix-reads-assembly"]
            input[2] = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
            """
            }
        }
    }

    test("homo_sapiens - forward strandedness") {

        when {
            process {
                """
                input[0] = STRINGTIE_STRINGTIE.out.map { r -> record(id: r.id, meta: r.meta, gtf: [r.transcript_gtf]) }
                input[1] = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                """
            }
        }

        then {
            def merged = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert snapshot(merged).match() }
            )
        }
    }

    test("homo_sapiens - reverse strandedness") {

        when {
            process {
                """
                input[0] = STRINGTIE_STRINGTIE.out.map { r -> record(id: r.id, meta: r.meta, gtf: [r.transcript_gtf]) }
                input[1] = file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                """
            }
        }

        then {
            def merged = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert snapshot(merged).match() }
            )
        }
    }
}
