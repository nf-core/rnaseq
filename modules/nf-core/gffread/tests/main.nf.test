nextflow_process {

    name "Test Process GFFREAD"
    script "../main.nf"
    process "GFFREAD"

    tag "gffread"
    tag "modules_nfcore"
    tag "modules"

    test("sarscov2-gff3-gtf") {

        config "./nextflow.config"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [id: 'test'],
                    gff: file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gff3", checkIfExists: true)
                )
                input[1] = null

                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out[0][0]).match() },
                { assert process.out[0][0].gff == null },
                { assert process.out[0][0].fasta == null }
            )
        }

    }

    test("sarscov2-gff3-gtf-stub") {

        options '-stub'
        config "./nextflow.config"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = record(
                    id: 'test',
