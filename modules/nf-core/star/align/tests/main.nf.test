        }

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = STAR_GENOMEGENERATE.out.index
                input[2] = channel.of([
                    [ id:'test_gtf' ],
                    [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true) ]
                ])
                input[3] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert (file(process.out.log_out[0][1]).text =~ /##### Command Line:\n(.+)/)[0][1].count('--readFilesCommand') == 1 },
                { assert snapshot(
                    bam(process.out.bam[0][1]).getReadsMD5(),
                    sanitizeOutput(process.out, unstableKeys: [ 'log_final', 'log_out', 'log_progress', 'bam', 'bam_sorted', 'bam_sorted_aligned', 'bam_transcript', 'bam_unsorted', 'junction' ])
                ).match() }
            )
