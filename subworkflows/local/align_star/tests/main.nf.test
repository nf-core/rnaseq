nextflow_workflow {

    name "Test Subworkflow ALIGN_STAR"
    script "../main.nf"
    workflow "ALIGN_STAR"
    config "./nextflow.config"

    test("star - no igenomes") {

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../../modules/nf-core/star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = channel.of(record(
                        id: 'test_fasta',
                        meta: [ id:'test_fasta' ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    ))
                    input[1] = channel.of([
                        [ id:'test_gtf' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                    ])
                    """
                }
            }
        }

        when {
            workflow {
                """
                star_ignore_sjdbgtf = false
                use_sentieon_star    = false
                use_parabricks_star  = false
                skip_markduplicates  = false

                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    reads: [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true)
                    ]
                ))
                input[1] = STAR_GENOMEGENERATE.out.map { r -> [r.meta, r.index] }
                input[2] = channel.of([
                    [ id:'test_gtf' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                ])
                input[3] = star_ignore_sjdbgtf
                input[4] = channel.of([
                    [ id:'test_fasta' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                ])
                input[5] = use_sentieon_star
                input[6] = use_parabricks_star
                input[7] = skip_markduplicates
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    file(workflow.out[0][0].star.log_final).name,
                    file(workflow.out[0][0].star.log_out).name,
                    file(workflow.out[0][0].bai).name,
                    bam(workflow.out[0][0].bam).getReadsMD5(),
                    workflow.out[0][0].star.log_progress,
                    workflow.out[0][0].unmapped,
                    workflow.out[0][0].samtools.flagstat,
                    workflow.out[0][0].samtools.idxstats,
                    bam(workflow.out[0][0].orig_bam[0]).getReadsMD5(),
                    workflow.out[0][0].samtools.stats,
                    workflow.out[0][0].star.tab).match()}
            )
        }

        cleanup {
            if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                "docker system prune -a -f --volumes".execute()
            }
            new File("${launchDir}").deleteDir()
        }
    }

    test("star - upgraded legacy 2.6.x index") {

        // Build a STAR 2.6.1d index, run it through STAR_GENOMEPARAMS_UPGRADE to rewrite
        // the genome-format metadata, then align with the modern STAR build that ships
        // with the pipeline. Exercises the full iGenomes-compatibility path.

        config "./nextflow.upgraded_legacy.config"

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../../modules/nf-core/star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = channel.of(record(
                        id: 'test_fasta',
                        meta: [ id:'test_fasta' ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    ))
                    input[1] = channel.of([
                        [ id:'test_gtf' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                    ])
                    """
                }
            }
            run("STAR_GENOMEPARAMS_UPGRADE") {
                script "../../../../modules/local/star_genomeparams_upgrade/main.nf"
                process {
                    """
                    input[0] = STAR_GENOMEGENERATE.out.map { r -> record(id: r.id, meta: r.meta, index: r.index) }
                    """
                }
            }
        }

        when {
            workflow {
                """
                star_ignore_sjdbgtf = false
                use_sentieon_star    = false
                use_parabricks_star  = false
                skip_markduplicates  = false

                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    reads: [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true)
                    ]
                ))
                input[1] = STAR_GENOMEPARAMS_UPGRADE.out.map { r -> [r.meta, r.index] }
                input[2] = channel.of([
                    [ id:'test_gtf' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                ])
                input[3] = star_ignore_sjdbgtf
                input[4] = channel.of([
                    [ id:'test_fasta' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                ])
                input[5] = use_sentieon_star
                input[6] = use_parabricks_star
                input[7] = skip_markduplicates
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    file(workflow.out[0][0].star.log_final).name,
                    file(workflow.out[0][0].star.log_out).name,
                    file(workflow.out[0][0].bai).name,
                    bam(workflow.out[0][0].bam).getReadsMD5(),
                    workflow.out[0][0].star.log_progress,
                    workflow.out[0][0].unmapped,
                    workflow.out[0][0].samtools.flagstat,
                    workflow.out[0][0].samtools.idxstats,
                    bam(workflow.out[0][0].orig_bam[0]).getReadsMD5(),
                    workflow.out[0][0].samtools.stats,
                    workflow.out[0][0].star.tab).match()}
            )
        }

        cleanup {
            if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                "docker system prune -a -f --volumes".execute()
            }
            new File("${launchDir}").deleteDir()
        }
    }

    test("star - no igenomes - stub") {

        options "-stub"

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../../modules/nf-core/star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = channel.of(record(
                        id: 'test_fasta',
                        meta: [ id:'test_fasta' ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    ))
                    input[1] = channel.of([
                        [ id:'test_gtf' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                    ])
                    """
                }
            }
        }

        when {
            workflow {
                """
                star_ignore_sjdbgtf = false
                use_sentieon_star    = false
                use_parabricks_star  = false
                skip_markduplicates  = false

                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    reads: [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true)
                    ]
                ))
                input[1] = STAR_GENOMEGENERATE.out.map { r -> [r.meta, r.index] }
                input[2] = channel.of([
                    [ id:'test_gtf' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)
                ])
                input[3] = star_ignore_sjdbgtf
                input[4] = channel.of([
                    [ id:'test_fasta' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                ])
                input[5] = use_sentieon_star
                input[6] = use_parabricks_star
                input[7] = skip_markduplicates
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    workflow.out[0][0].bai,
                    workflow.out[0][0].bam,
                    workflow.out[0][0].bam_sorted,
                    workflow.out[0][0].transcriptome_bam,
                    workflow.out[0][0].samtools.flagstat,
                    workflow.out[0][0].samtools.idxstats,
                    workflow.out[0][0].star.log_final,
                    workflow.out[0][0].star.log_out,
                    workflow.out[0][0].star.log_progress,
                    workflow.out[0][0].orig_bam,
                    workflow.out[0][0].samtools.stats,
                    workflow.out[0][0].star.tab).match()}
            )
        }

        cleanup {
            if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                "docker system prune -a -f --volumes".execute()
            }
            new File("${launchDir}").deleteDir()
        }
    }

}
