process {
    withName: '.*:FASTQ_FASTQC_UMITOOLS_FASTP:FASTQC_RAW' {
        ext.args   = '--quiet'
        ext.prefix = { "${sample.meta.id}_raw" }
    }

    withName: '.*:FASTQ_FASTQC_UMITOOLS_FASTP:FASTQC_TRIM' {
        ext.args   = '--quiet'
        ext.prefix = { "${sample.meta.id}_trimmed" }
    }
}
