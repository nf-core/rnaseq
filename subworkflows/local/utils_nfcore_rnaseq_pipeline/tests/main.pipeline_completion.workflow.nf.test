nextflow_workflow {

    name "Test Workflow PIPELINE_COMPLETION"
    script "../main.nf"
    workflow "PIPELINE_COMPLETION"

    test("test PIPELINE_COMPLETION successfully completes") {

        options "-output-dir $outputDir"

        when {
            workflow {
                """
                input[0] = null                              // email (only used by completionEmail when set)
                input[1] = null                              // email_on_fail (likewise)
                input[2] = true                              // plaintext_email
                input[3] = true                              // monochrome_logs
                input[4] = "${outputDir}/multiqc_report.html" // multiqc_report
                input[5] = channel.of(record(id: 'test_sample', pass: true))
                input[6] = channel.of(record(id: 'test_sample', pass: true))
                input[7] = channel.of(record(id: 'test_sample', pass: true))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success}
            )
        }

    }

}
