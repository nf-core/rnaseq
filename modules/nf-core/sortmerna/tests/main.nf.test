nextflow_process {

    name "Test Process SORTMERNA"
    script "../main.nf"
    process "SORTMERNA"
    tag "modules"
    tag "modules_nfcore"
    tag "sortmerna"

    test("sarscov2 indexing only") {

        config './indexing_only.config'

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [:],
                    reads: []
                )
                input[1] = [ [id:'test2'], // meta map
                    [ file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true) ]
                ]
                input[2] = [[:], null]
                """
            }
        }

        then {
            def sm = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert ! sm.reads },
                { assert snapshot(
                    file(sm.index).listFiles().findAll { !it.name.endsWith(".stats") }.sort { it.name }
                ).match() }
            )
        }

    }

    test("sarscov2 indexing only stub") {

        options '-stub'
        config './indexing_only.config'

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [:],
                    reads: []
                )
                input[1] = [ [id:'test2'], // meta map
                    [ file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true) ]
                ]
                input[2] = [[:], null]
                """
            }
        }

        then {
            def sm = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert ! sm.reads },
                { assert snapshot(file(sm.index).name).match("index_only_stub") }
            )
        }

    }

    test("sarscov2 single_end") {

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test' ],
                    reads: [ file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz", checkIfExists: true) ]
                )
                input[1] = [ [id:'test2'], // meta map
                    [ file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true) ]
                ]
                input[2] = [[:], null]
                """
            }
        }

        then {
            def sm = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert sm.reads },
                { assert file(sm.log).text.contains("Total reads passing E-value threshold = 100 (100.00)") },
                {
                    assert snapshot(
                        (
                            [sm.meta.toString()] + // meta
                            sm.reads.collect { f -> file(f).getName() } +
                            [file(sm.log).getName()]
                        ).sort()
                    ).match("sarscov2 single_end_match")
                },
                { assert snapshot(
                    file(sm.index).listFiles().findAll { !it.name.endsWith(".stats") }.sort { it.name }
                ).match("index_single_end")}
            )
        }

    }

    test("sarscov2 single_end stub") {

        options '-stub'

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test' ],
                    reads: [ file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz", checkIfExists: true) ]
                )
                input[1] = [ [id:'test2'], // meta map
                    [ file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true) ]
                ]
                input[2] = [[:], null]
                """
            }
        }

        then {
            def sm = process.out[0][0]
            assertAll(
                { assert process.success },
                {
                    assert snapshot(
                        (
                            [sm.meta.toString()] + // meta
                            sm.reads.collect { f -> file(f).getName() } +
                            [file(sm.log).getName()]
                        ).sort()
                    ).match("sarscov2 single_end-for_stub_match")
                },
                { assert snapshot(file(sm.index).name).match("index_single_end_stub") }
            )
        }

    }

    test("sarscov2 paired_end") {

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test' ],
                    reads: [
                        file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_2.fastq.gz", checkIfExists: true)
                    ]
                )
                input[1] = [ [id:'test2'], // meta map
                    [ file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true) ]
                ]
                input[2] = [[:], null]
                """
            }
        }

        then {
            def sm = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert sm.reads },
                { assert file(sm.log).text.contains("Total reads passing E-value threshold = 200 (100.00)") },
                {
                    assert snapshot(
                        (
                            [sm.meta.toString()] + // meta
                            sm.reads.collect { item -> file(item).getName() } +
                            [file(sm.log).getName()]
                        ).sort()
                    ).match("sarscov2 paired_end_match")
                },
                { assert snapshot(
                    file(sm.index).listFiles().findAll { !it.name.endsWith(".stats") }.sort { it.name }
                ).match("index_paired_end") }

            )
        }

    }

