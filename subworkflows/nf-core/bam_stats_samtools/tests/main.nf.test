nextflow_workflow {

    name "Test Workflow BAM_STATS_SAMTOOLS"
    script "../main.nf"
    workflow "BAM_STATS_SAMTOOLS"
    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "bam_stats_samtools"
    tag "subworkflows/bam_stats_samtools"
    tag "samtools"
    tag "samtools/flagstat"
    tag "samtools/idxstats"
    tag "samtools/stats"

    test("test_bam_stats_samtools_single_end") {

        when {
            workflow {
                """
                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.single_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.single_end.sorted.bam.bai', checkIfExists: true)
                ))
                input[1] = Channel.of(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true))
                input[2] = Channel.of(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    workflow.out[0][0].samtools.flagstat,
                    workflow.out[0][0].samtools.idxstats,
                    workflow.out[0][0].samtools.stats).match() }
            )
        }
    }

    test("test_bam_stats_samtools_paired_end") {

        when {
            workflow {
                """
                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ))
                input[1] = Channel.of(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true))
                input[2] = Channel.of(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true))
