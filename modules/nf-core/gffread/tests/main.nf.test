    test("sarscov2-gff3-fasta-fail-catch") {

        options '-stub'
        config "./nextflow-fasta.config"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = record(
                    id: 'genome',
                    meta: [id: 'genome'],
                    gff: file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gff3", checkIfExists: true)
                )
                input[1] = file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true)
                """
            }
        }

        then {
            assertAll (
                { assert ! process.success },
                { assert process.stdout.toString().contains("Input and output names are the same") }
            )
        }

    }

