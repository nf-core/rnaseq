nextflow_process {

    name "Test Process BOWTIE2_ALIGN"
    script "../main.nf"
    process "BOWTIE2_ALIGN"
    tag "modules"
    tag "modules_nfcore"
    tag "bowtie2"
    tag "bowtie2/build"
    tag "bowtie2/align"

    test("sarscov2 - fastq, index, fasta_fai, false, true - bam") {

        config "./bam.config"
        setup {
            run("BOWTIE2_BUILD") {
                script "../../build/main.nf"
                process {
                    """
                    input[0] = record(
                        id: 'test',
                        meta: [ id:'test'],
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    )
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    reads: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                )
                input[1] = BOWTIE2_BUILD.out.map { r -> r.index }
                input[2] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                input[3] = false //save_unaligned
                input[4] = true //sort
                """
            }
        }

        then {
            def aln = process.out[0][0]
            assertAll (
                { assert process.success },
                { assert snapshot(
                    // Conda and docker version of bowtie2 produce different
                    // hashes. Therefore, testing whether file exists and bam
                    // statistics.
                    file(aln.raw_bams[0]).name,
                    bam(aln.raw_bams[0], stringency: "silent").getStatistics(exclude:["sorted"]),
                    aln.bowtie2.log,
                    aln.unmapped,
                ).match() }
            )
        }

    }

