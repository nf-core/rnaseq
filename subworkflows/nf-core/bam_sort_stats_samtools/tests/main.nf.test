nextflow_workflow {

    name "Test Workflow BAM_SORT_STATS_SAMTOOLS"
    script "../main.nf"
    workflow "BAM_SORT_STATS_SAMTOOLS"
    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/bam_sort_stats_samtools"
    tag "bam_sort_stats_samtools"
    tag "subworkflows/bam_stats_samtools"
    tag "bam_stats_samtools"
    tag "samtools"
    tag "samtools/index"
    tag "samtools/sort"
    tag "samtools/stats"
    tag "samtools/idxstats"
    tag "samtools/flagstat"

    test("test_bam_sort_stats_samtools_single_end") {

        when {
            workflow {
                """
                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    raw_bams: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.single_end.bam', checkIfExists: true)
                ))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true))
                input[2] = channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert workflow.out[0][0].bam ==~ ".*.bam"},
                { assert workflow.out[0][0].bai ==~ ".*.bai"},
                { assert snapshot(
                    workflow.out[0][0].samtools.flagstat,
                    workflow.out[0][0].samtools.idxstats,
                    workflow.out[0][0].samtools.stats).match() }
            )
        }
    }

    test("test_bam_sort_stats_samtools_paired_end") {

        when {
            workflow {
                """
                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    raw_bams: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true)
                ))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true))
                input[2] = channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert workflow.out[0][0].bam ==~ ".*.bam"},
                { assert workflow.out[0][0].bai ==~ ".*.bai"},
                { assert snapshot(
                    workflow.out[0][0].samtools.flagstat,
                    workflow.out[0][0].samtools.idxstats,
                    workflow.out[0][0].samtools.stats).match() }
            )
        }
    }

    test("test_bam_sort_stats_samtools_single_end - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    raw_bams: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.single_end.bam', checkIfExists: true)
                ))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true))
                input[2] = channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("test_bam_sort_stats_samtools_paired_end - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    raw_bams: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true)
                ))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true))
                input[2] = channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
