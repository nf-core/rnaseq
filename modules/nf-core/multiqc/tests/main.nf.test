    test("sarscov2 single-end [fastqc] - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'FASTQC',
                    meta: [ id: 'FASTQC' ],
                    multiqc_files: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastqc/test_fastqc.zip', checkIfExists: true),
                    multiqc_config: [],
                    multiqc_logo: null,
                    replace_names: null,
                    sample_names: null
                ))
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out[0][0]).match() }
            )
        }
    }
}
