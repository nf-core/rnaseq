nextflow_process {

    name "Test Process SALMON_INDEX"
    script "../main.nf"
    process "SALMON_INDEX"
    tag "modules"
    tag "modules_nfcore"
    tag "salmon"
    tag "salmon/index"

    test("sarscov2") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    transcript_fasta: file(params.modules_testdata_base_path + "genomics/sarscov2/genome/transcriptome.fasta", checkIfExists: true),
                    genome_fasta: file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.fasta", checkIfExists: true)
                ))
                """
            }
        }

        then {
            def idx = process.out[0][0]
            def idx_dir = new File(idx.index.toString())
            def idx_files = []
            if (idx_dir.isDirectory()) { idx_dir.eachFileRecurse(groovy.io.FileType.FILES) { f -> idx_files << f.name } }
            assertAll(
                { assert process.success },
                { assert snapshot(idx.meta, idx_dir.isDirectory() ? idx_files.sort() : idx_dir.name).match()}
            )
        }

    }

    test("sarscov2 transcriptome only") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    transcript_fasta: file(params.modules_testdata_base_path + "genomics/sarscov2/genome/transcriptome.fasta", checkIfExists: true),
                    genome_fasta: []
                ))
                """
            }
        }

        then {
            def idx = process.out[0][0]
            def idx_dir = new File(idx.index.toString())
            def idx_files = []
            if (idx_dir.isDirectory()) { idx_dir.eachFileRecurse(groovy.io.FileType.FILES) { f -> idx_files << f.name } }
            assertAll(
                { assert process.success },
                { assert snapshot(idx.meta, idx_dir.isDirectory() ? idx_files.sort() : idx_dir.name).match()}
            )
        }

    }

    test("sarscov2 stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    transcript_fasta: file(params.modules_testdata_base_path + "genomics/sarscov2/genome/transcriptome.fasta", checkIfExists: true),
                    genome_fasta: file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.fasta", checkIfExists: true)
                ))
                """
            }
        }

        then {
            def idx = process.out[0][0]
            def idx_dir = new File(idx.index.toString())
            def idx_files = []
            if (idx_dir.isDirectory()) { idx_dir.eachFileRecurse(groovy.io.FileType.FILES) { f -> idx_files << f.name } }
            assertAll(
                { assert process.success },
                { assert snapshot(idx.meta, idx_dir.isDirectory() ? idx_files.sort() : idx_dir.name).match()}
            )
        }

    }

}
