nextflow_process {

    name "Test Process STAR_ALIGN"
    script "../main.nf"
    process "STAR_ALIGN"
    tag "modules"
    tag "modules_nfcore"
    tag "star"
    tag "star/align"
    tag "star/genomegenerate"

    test("homo_sapiens - single_end") {
        config "./nextflow.config"

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = Channel.of(record(
                        id: 'test_fasta',
                        meta: [ id:'test_fasta' ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    ))
                    input[1] = Channel.of(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true))
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    reads: [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true) ]
                ))
                input[1] = STAR_GENOMEGENERATE.out.map { r -> r.index }
                input[2] = Channel.of(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true))
                input[3] = false
                """
            }
        }

        then {
            def aln = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(aln.star.log_final).name,
                    file(aln.star.log_out).name,
                    file(aln.star.log_progress).name,
                    bam(aln.raw_bams[0]).getReadsMD5(),
                    bam(aln.bam_sorted_aligned).getReadsMD5(),
                    aln.bedgraph,
                    aln.unmapped,
                    aln.read_per_gene_tab,
                    aln.sam,
                    aln.spl_junc_tab,
                    aln.star.tab,
                    aln.wig,
                ).match() }
            )
        }
    }

