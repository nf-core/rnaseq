nextflow_process {

    name "Test Process KALLISTO_INDEX"
    script "../main.nf"
    process "KALLISTO_INDEX"
    tag "modules"
    tag "modules_nfcore"
    tag "kallisto"
    tag "kallisto/index"

    test("sarscov2 transcriptome.fasta") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'transcriptome' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            def idx = process.out[0][0]
            def idx_dir = new File(idx.index.toString())
            def idx_files = []
            if (idx_dir.isDirectory()) { idx_dir.eachFileRecurse(groovy.io.FileType.FILES) { f -> idx_files << f.name } }
            assertAll(
                { assert process.success },
                { assert snapshot(idx.meta, idx_dir.isDirectory() ? idx_files.sort() : idx_dir.name).match() }
            )
        }
    }

    test("sarscov2 transcriptome.fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'transcriptome' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                ])
                """
            }
        }

        then {
            def idx = process.out[0][0]
            def idx_dir = new File(idx.index.toString())
            def idx_files = []
            if (idx_dir.isDirectory()) { idx_dir.eachFileRecurse(groovy.io.FileType.FILES) { f -> idx_files << f.name } }
            assertAll(
                { assert process.success },
                { assert snapshot(idx.meta, idx_dir.isDirectory() ? idx_files.sort() : idx_dir.name).match() }
            )
        }
    }
}
