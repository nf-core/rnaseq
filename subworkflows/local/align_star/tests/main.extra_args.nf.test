nextflow_workflow {

    name "Test Subworkflow ALIGN_STAR - extra_star_align_args"
    script "../main.nf"
    workflow "ALIGN_STAR"
    config "./nextflow.extra_args.config"

    test("star - extra_star_align_args with overlapping defaults") {

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../../modules/nf-core/star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = channel.of(record(
                        id: 'test_fasta',
                        meta: [ id:'test_fasta' ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    ))
                    input[1] = channel.of(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true))
                    """
                }
            }
        }

        when {
            workflow {
                """
                star_ignore_sjdbgtf = false
                use_sentieon_star    = false
                use_parabricks_star  = false
                skip_markduplicates  = false

                input[0] = new nextflow.dataflow.ChannelImpl(channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    args: "--quantMode TranscriptomeSAM --outSAMtype BAM Unsorted --outSAMattributes NH HI AS NM MD --readFilesCommand zcat --twopassMode Basic --runRNGseed 0 --outFilterMultimapNmax 10 --alignSJDBoverhangMin 1 --outSAMstrandField intronMotif --quantTranscriptomeSAMoutput BanSingleEnd --outFilterMismatchNoverLmax 0.1 --outSAMattrRGline 'ID:test' 'SM:test'",
                    reads: [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true)
                    ]
                )))
                input[1] = new nextflow.dataflow.ValueImpl(STAR_GENOMEGENERATE.out.map { r -> r.index }.first())
                input[2] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)))
                input[3] = star_ignore_sjdbgtf
                input[4] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)))
                input[5] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)))
                input[6] = use_sentieon_star
                input[7] = use_parabricks_star
                input[8] = skip_markduplicates
                input[9] = record(samtools_index: '')  // tool_args
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    file(workflow.out[0][0].star.log_final).name,
                    file(workflow.out[0][0].star.log_out).name,
                    file(workflow.out[0][0].bai).name,
                    bam(workflow.out[0][0].bam).getReadsMD5(),
                    file(workflow.out[0][0].star.log_progress).name,
                    workflow.out[0][0].unmapped,
                    workflow.out[0][0].samtools.flagstat,
                    workflow.out[0][0].samtools.idxstats,
                    bam(workflow.out[0][0].raw_bams[0]).getReadsMD5(),
                    workflow.out[0][0].samtools.stats,
                    workflow.out[0][0].star.tab).match()}
            )
        }

        cleanup {
            if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                "docker system prune -a -f --volumes".execute()
            }
            new File("${launchDir}").deleteDir()
        }
    }
}
