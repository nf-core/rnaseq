nextflow_pipeline {

    name "Test pipeline with Salmon, skipping both QC and alignment"
    script "../main.nf"
    tag "pipeline"

    // Transcript FASTA with one deliberate exact-sequence duplicate: the real test transcriptome
    // (needed so CUSTOM_TX2GENE's transcript-ID/GTF-attribute discovery has real IDs to match; a
    // purely synthetic transcript set makes it fail outright) plus two short synthetic records
    // that duplicate each other. Generated at test time rather than committed, so no binary/data
    // fixture lives in the repo. The duplicate sequence just needs to exceed the default k-mer
    // size (31) so Salmon indexes it at all.
    def DUPLICATE_TRANSCRIPT_FASTA = new URL('https://raw.githubusercontent.com/nf-core/test-datasets/7f1614baeb0ddf66e60be78c3d9fa55440465ac8/reference/transcriptome.fasta').text +
        ">PRIMARY_TX_FIXTURE\nACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT\n" +
        ">DUPLICATE_TX_FIXTURE\nACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT\n"

    test("Params: --pseudo_aligner salmon --skip_qc --skip_alignment") {

        when {
            params {
                outdir = "$outputDir"
                pseudo_aligner = 'salmon'
                skip_qc = true
                skip_alignment = true
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow and pipeline versions are removed (all from the workflow key)
                    removeFromYamlMap("$outputDir/pipeline_info/nf_core_rnaseq_software_mqc_versions.yml", "Workflow"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }

        cleanup {
            // Only prune/delete on CI - keeping local VM state intact prevents
            // cross-test launchDir wipes that break nf-test snapshot walks.
            if (System.getenv("CI") == "true") {
                if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                    "docker system prune -a -f --volumes".execute()
                }
                new File("${launchDir}").deleteDir()
            }
        }
    }

