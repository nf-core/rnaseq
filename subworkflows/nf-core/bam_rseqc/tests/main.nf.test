nextflow_workflow {

    name "Test Workflow BAM_RSEQC"
    script "../main.nf"
    workflow "BAM_RSEQC"
    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/bam_rseqc"
    tag "bam_rseqc"
    tag "rseqc"
    tag "rseqc/bamstat"
    tag "rseqc/inferexperiment"
    tag "rseqc/innerdistance"
    tag "rseqc/junctionannotation"
    tag "rseqc/junctionsaturation"
    tag "rseqc/readdistribution"
    tag "rseqc/readduplication"
    tag "rseqc/tin"

    test("sarscov2 paired-end [bam]") {

        when {
            workflow {
                """
                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed12', checkIfExists: true))
                input[2] = ['bam_stat', 'inner_distance', 'infer_experiment', 'junction_annotation', 'junction_saturation', 'read_distribution', 'read_duplication', 'tin']
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert workflow.out[0][0].innerdistance.pdf.name.endsWith('.pdf') },
                { assert workflow.out[0][0].readduplication.pdf.name.endsWith('.pdf') },
                { assert workflow.out[0][0].junctionsaturation.pdf.name.endsWith('.pdf') },
                { assert snapshot(
                    workflow.out[0][0].bamstat,
                    workflow.out[0][0].innerdistance.distance,
                    workflow.out[0][0].inferexperiment,
                    workflow.out[0][0].junctionannotation.xls,
                    workflow.out[0][0].junctionannotation.log,
                    workflow.out[0][0].junctionsaturation.rscript,
                    workflow.out[0][0].readdistribution,
                    workflow.out[0][0].readduplication.pos_xls,
                    workflow.out[0][0].tin.txt).match()}
            )
        }
    }

    test("sarscov2 paired-end [bam] no modules") {

        when {
            workflow {
                """
                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed12', checkIfExists: true))
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out[0][0].bamstat == null },
                { assert workflow.out[0][0].innerdistance == null },
                { assert workflow.out[0][0].inferexperiment == null },
                { assert workflow.out[0][0].junctionannotation == null },
                { assert workflow.out[0][0].junctionsaturation == null },
                { assert workflow.out[0][0].readdistribution == null },
                { assert workflow.out[0][0].readduplication == null },
                { assert workflow.out[0][0].tin == null }
            )
        }
    }

    test("sarscov2 paired-end [bam] - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed12', checkIfExists: true))
                input[2] = ['bam_stat', 'inner_distance', 'infer_experiment', 'junction_annotation', 'junction_saturation', 'read_distribution', 'read_duplication', 'tin']
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(workflow.out).match()}
            )
        }
    }

    test("sarscov2 paired-end [bam] no modules - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ))
                input[1] = channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed12', checkIfExists: true))
                input[2] = []
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(workflow.out).match()}
            )
        }
    }
}
