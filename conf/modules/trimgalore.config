process {
    withName: '.*:FASTQ_FASTQC_UMITOOLS_TRIMGALORE:FASTQC' {
        ext.args   = '--quiet'
        ext.prefix = { "${sample.meta.id}_raw" }
    }

    withName: '.*:FASTQ_FASTQC_UMITOOLS_TRIMGALORE:TRIMGALORE' {
        cpus       = { 8 * task.attempt }
        memory     = { 4.GB * task.attempt }
        ext.args   = { "--fastqc_args '-t ${task.cpus}'" }
        ext.prefix = { "${sample.meta.id}_trimmed" }
    }
}
