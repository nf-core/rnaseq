        ],
        [
            name: 'Robert Syme',
            affiliation: 'Seqera',
            github: '@robsyme',
            contribution: ['contributor'],
            orcid: '0000-0002-8721-2350'
        ],
    ]
    homePage        = 'https://github.com/nf-core/rnaseq'
    description     = """RNA sequencing analysis pipeline for gene/isoform quantification and extensive quality control."""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.09.0-edge'
    version         = '3.28.0dev'
    doi             = 'https://doi.org/10.5281/zenodo.1400710'
    diagram         = 'docs/images/nf-core-rnaseq_metro_map_animated.svg'
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.7.2-channel.2' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes", "igenomes_base"]
    monochromeLogs = params.monochrome_logs
}
// Load DSL2 module specific options

// prepare reference
includeConfig 'conf/modules/prepare_genome.config'

// pre-processing
includeConfig 'conf/modules/fastp.config'
includeConfig 'conf/modules/trimgalore.config'
includeConfig 'conf/modules/qc_trim_filter.config'
includeConfig 'conf/modules/strandedness.config'
includeConfig 'conf/modules/bbsplit.config'
includeConfig 'conf/modules/sortmerna.config'

// alignment
includeConfig 'conf/modules/align_star.config'
includeConfig 'conf/modules/align_bowtie2.config'
includeConfig 'conf/modules/align_hisat2.config'
includeConfig 'conf/modules/markduplicates.config'

// quantification
includeConfig './subworkflows/nf-core/quantify_rsem/nextflow.config'
includeConfig './subworkflows/nf-core/quantify_pseudo_alignment/nextflow.config'
includeConfig './subworkflows/nf-core/quant_tximport_summarizedexperiment/nextflow.config'

// QC
includeConfig 'conf/modules/featurecounts.config'
includeConfig 'conf/modules/stringtie.config'
includeConfig 'conf/modules/qualimap.config'
includeConfig 'conf/modules/preseq.config'
includeConfig 'conf/modules/rustqc.config'
includeConfig 'conf/modules/kraken2.config'
includeConfig 'conf/modules/bracken.config'
includeConfig 'conf/modules/sylph.config'
includeConfig 'conf/modules/multiqc.config'

// Pipeline-level process overrides
// NOTE: Order matters - later configs take precedence when multiple
// withName selectors match the same process.
includeConfig 'conf/modules/quantify_bam_salmon.config'
includeConfig 'conf/modules/alignment.config'
includeConfig 'conf/modules/umi_dedup.config'
includeConfig 'conf/modules/bigwig.config'
includeConfig 'conf/modules/deseq2_qc.config'
includeConfig 'conf/modules/quantify_rsem.config'
includeConfig 'conf/modules/quantify_pseudo_alignment.config'
