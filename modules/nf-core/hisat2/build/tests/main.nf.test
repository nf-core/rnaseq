nextflow_process {

    name "Test Process HISAT2_BUILD"
    script "../main.nf"
    process "HISAT2_BUILD"
    tag "modules"
    tag "modules_nfcore"
    tag "hisat2"
    tag "hisat2/build"
    tag "hisat2/extractsplicesites"

    test("Should run without failures") {

        setup {
            run("HISAT2_EXTRACTSPLICESITES") {
                script "../../extractsplicesites/main.nf"
                process {
                """
                input[0] = Channel.of(record(
                    id: 'genome',
                    meta: [id:'genome'],
                    gtf: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.gtf', checkIfExists: true)
                ))
                """
                }
            }
        }

        when {
            process {
                """
                def fasta_file = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                def gtf_file = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.gtf', checkIfExists: true)
                input[0] = HISAT2_EXTRACTSPLICESITES.out.map { r -> record(id: r.id, meta: r.meta, fasta: fasta_file, gtf: gtf_file, splicesites: r.splicesites) }
                input[1] = false
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out[0][0].meta, file(process.out[0][0].index).listFiles().collect { f -> f.name }.sort()).match() }
            )
        }
    }

    test("Should run without failures - stub") {

        options "-stub"

        setup {
            run("HISAT2_EXTRACTSPLICESITES") {
                script "../../extractsplicesites/main.nf"
                process {
                """
                input[0] = Channel.of(record(
                    id: 'genome',
                    meta: [id:'genome'],
                    gtf: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.gtf', checkIfExists: true)
                ))
                """
                }
            }
        }

        when {

            process {
                """
                def fasta_file = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                def gtf_file = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.gtf', checkIfExists: true)
                input[0] = HISAT2_EXTRACTSPLICESITES.out.map { r -> record(id: r.id, meta: r.meta, fasta: fasta_file, gtf: gtf_file, splicesites: r.splicesites) }
                input[1] = false
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("Should use splice sites when memory threshold is met") {

        setup {
            run("HISAT2_EXTRACTSPLICESITES") {
                script "../../extractsplicesites/main.nf"
                process {
                """
                input[0] = Channel.of(record(
                    id: 'genome',
                    meta: [id:'genome'],
                    gtf: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.gtf', checkIfExists: true)
                ))
                """
                }
            }
        }

        when {
            process {
                """
                def fasta_file = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                def gtf_file = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.gtf', checkIfExists: true)
                input[0] = HISAT2_EXTRACTSPLICESITES.out.map { r -> record(id: r.id, meta: r.meta, fasta: fasta_file, gtf: gtf_file, splicesites: r.splicesites) }
                input[1] = '3.GB'
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out[0][0].meta, file(process.out[0][0].index).listFiles().collect { f -> f.name }.sort()).match() }
            )
        }
    }
}
