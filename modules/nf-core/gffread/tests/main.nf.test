                )
                input[1] = null
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out[0][0]).match() },
                { assert process.out[0][0].gff == null },
                { assert process.out[0][0].fasta == null }
            )
        }

    }

