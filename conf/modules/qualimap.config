process {
    withName: 'SAMTOOLS_SORT_QUALIMAP' {
        ext.args = '-n'
        ext.prefix = { "${meta.id}.namesorted" }
        publishDir = [
            enabled: false
        ]
    }

    withName: 'QUALIMAP_RNASEQ' {
        ext.args = { [
            '--sorted',
            meta.strandedness == 'forward' ? '-p strand-specific-forward' :
                meta.strandedness == 'reverse' ? '-p strand-specific-reverse' :
                '-p non-strand-specific'
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/qualimap" },
            mode: params.publish_dir_mode
        ]
    }
}
