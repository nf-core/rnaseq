nextflow_pipeline {

    name "Test full pipeline with extra RiboDetector arguments in debug mode"
    script "../main.nf"
    // CI appends its test and container profiles with --profile=+test,docker.
    profile "debug"
    tag "pipeline"
    tag "ribodetector"
    tag "remove_ribo_rna"
    tag "debug"

    test("Params: full workflow with --extra_ribodetector_args and debug profile") {

        when {
            params {
                outdir = "$outputDir"
                remove_ribo_rna = true
                ribo_removal_tool = 'ribodetector'
                extra_ribodetector_args = '--chunk_size 256 --seed 1'
            }
        }

        then {
            def ribodetectorTasks = workflow.trace.succeeded().findAll { it.name.contains(':RIBODETECTOR') }
            def ribodetectorLogs = new File("$outputDir/ribodetector").listFiles()?.findAll { it.name.endsWith('.log') } ?: []
            def ribodetectorCommands = []
            new File("$workDir").eachFileRecurse { file ->
                if (file.name == '.command.sh' && file.text.contains('ribodetector_cpu')) {
                    ribodetectorCommands << file.text
                }
            }
            // Debug enables selector warnings; leave unrelated pipeline warnings out of this assertion.
            def ribodetectorWarnings = (workflow.stdout + workflow.stderr).findAll {
                it.contains('WARN') && it.contains('RIBODETECTOR')
            }

            assertAll(
                { assert workflow.success },
                { assert !ribodetectorTasks.isEmpty() },
                { assert ribodetectorLogs.size() == ribodetectorTasks.size() },
                { assert ribodetectorCommands.size() == ribodetectorTasks.size() },
                { assert ribodetectorCommands.every { it.contains('-t 2 ') && it.contains('--chunk_size 256 --seed 1') } },
                { assert ribodetectorLogs.every { it.text.replaceAll(/\u001B\[[;\d]*m/, '').contains('reads with chunk size 256') } },
                { assert path("$outputDir/multiqc/star_salmon/multiqc_report.html").exists() },
                { assert ribodetectorWarnings.isEmpty() : ribodetectorWarnings.join('\n') }
            )
        }
    }
}
