nextflow_workflow {

    name "Test Subworkflow ALIGN_STAR - Read Groups"
    script "../main.nf"
    workflow "ALIGN_STAR"
    config "./nextflow.rg.config"

    test("star - read group from params only") {

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../../modules/nf-core/star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = channel.of(record(
                        id: 'test_fasta',
                        meta: [ id:'test_fasta' ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    ))
                    input[1] = channel.of(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true))
                    """
                }
            }
        }

        when {
            workflow {
                """
                star_ignore_sjdbgtf = false
                use_sentieon_star    = false
                use_parabricks_star  = false
                skip_markduplicates  = false

                input[0] = new nextflow.dataflow.ChannelImpl(channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false, seq_platform:'ILLUMINA' ],
                    args: '--quantMode TranscriptomeSAM --outSAMtype BAM Unsorted --outSAMattributes NH HI AS NM MD --readFilesCommand zcat --twopassMode Basic --runRNGseed 0 --outFilterMultimapNmax 20 --alignSJDBoverhangMin 1 --outSAMstrandField intronMotif --quantTranscriptomeSAMoutput BanSingleEnd --outSAMattrRGline 'ID:test' 'SM:test' 'PL:ILLUMINA' 'CN:GLOBAL_CENTER'',
                    reads: [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true)
                    ]
                )))
                input[1] = new nextflow.dataflow.ValueImpl(STAR_GENOMEGENERATE.out.map { r -> r.index }.first())
                input[2] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)))
                input[3] = star_ignore_sjdbgtf
                input[4] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)))
                input[5] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)))
                input[6] = use_sentieon_star
                input[7] = use_parabricks_star
                input[8] = skip_markduplicates
                input[9] = record(samtools_index: '')  // tool_args
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // params.seq_center = 'GLOBAL_CENTER' (from nextflow.rg.config), no meta.seq_center
                { assert bam(workflow.out[0][0].bam).getHeader().any { line -> line.contains('CN:GLOBAL_CENTER') } },
                { assert bam(workflow.out[0][0].bam).getHeader().any { line -> line.contains('PL:ILLUMINA') } },
                { assert bam(workflow.out[0][0].bam).getHeader().any { line -> line.contains('SM:test') } }
            )
        }

        cleanup {
            if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                "docker system prune -a -f --volumes".execute()
            }
            new File("${launchDir}").deleteDir()
        }
    }

    test("star - read group meta overrides params") {

        setup {
            run("STAR_GENOMEGENERATE") {
                script "../../../../modules/nf-core/star/genomegenerate/main.nf"
                process {
                    """
                    input[0] = channel.of(record(
                        id: 'test_fasta',
                        meta: [ id:'test_fasta' ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    ))
                    input[1] = channel.of(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true))
                    """
                }
            }
        }

        when {
            workflow {
                """
                star_ignore_sjdbgtf = false
                use_sentieon_star    = false
                use_parabricks_star  = false
                skip_markduplicates  = false

                input[0] = new nextflow.dataflow.ChannelImpl(channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false, seq_platform:'ILLUMINA', seq_center:'SAMPLE_CENTER' ],
                    args: '--quantMode TranscriptomeSAM --outSAMtype BAM Unsorted --outSAMattributes NH HI AS NM MD --readFilesCommand zcat --twopassMode Basic --runRNGseed 0 --outFilterMultimapNmax 20 --alignSJDBoverhangMin 1 --outSAMstrandField intronMotif --quantTranscriptomeSAMoutput BanSingleEnd --outSAMattrRGline 'ID:test' 'SM:test' 'PL:ILLUMINA' 'CN:SAMPLE_CENTER'',
                    reads: [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true)
                    ]
                )))
                input[1] = new nextflow.dataflow.ValueImpl(STAR_GENOMEGENERATE.out.map { r -> r.index }.first())
                input[2] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true)))
                input[3] = star_ignore_sjdbgtf
                input[4] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)))
                input[5] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)))
                input[6] = use_sentieon_star
                input[7] = use_parabricks_star
                input[8] = skip_markduplicates
                input[9] = record(samtools_index: '')  // tool_args
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // meta.seq_center = 'SAMPLE_CENTER' should override params.seq_center = 'GLOBAL_CENTER'
                { assert bam(workflow.out[0][0].bam).getHeader().any { line -> line.contains('CN:SAMPLE_CENTER') } },
                { assert !bam(workflow.out[0][0].bam).getHeader().any { line -> line.contains('CN:GLOBAL_CENTER') } },
                { assert bam(workflow.out[0][0].bam).getHeader().any { line -> line.contains('PL:ILLUMINA') } }
            )
        }

        cleanup {
            if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                "docker system prune -a -f --volumes".execute()
            }
            new File("${launchDir}").deleteDir()
        }
    }
}
