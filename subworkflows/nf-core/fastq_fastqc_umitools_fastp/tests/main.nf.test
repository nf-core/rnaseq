    test("sarscov2 paired-end [fastq] | skip_trimming") {

        when {
            params {
                skip_fastqc       = false
                with_umi          = false
                skip_umi_extract  = false
                umi_discard_read  = 1
                skip_trimming     = true
                save_trimmed_fail = false
                save_merged       = false
                min_trimmed_reads = 1
                fastp_args        = ""
            }
            workflow {
                """
                input[0] = new nextflow.dataflow.ChannelImpl(Channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    reads: [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ],
                    adapter_fasta: null
                )))
                input[1] = params.skip_fastqc
                input[2] = params.with_umi
                input[3] = params.skip_umi_extract
                input[4] = params.umi_discard_read
                input[5] = params.skip_trimming
                input[6] = params.save_trimmed_fail
                input[7] = params.save_merged
                input[8] = params.min_trimmed_reads
                input[9] = record(umi_extract: '', fastp: null)  // tool_args
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert workflow.out[0][0].fastqc_raw_html },
                { assert workflow.out[0][0].fastqc_raw_zip },
                { assert !workflow.out[0][0].fastqc_trim_html },
                { assert !workflow.out[0][0].fastqc_trim_zip },
                { assert !workflow.out[0][0].trim?.html },
                { assert !workflow.out[0][0].trim?.log },
                { assert snapshot(
                        // If we skip trimming then input is output, so not snapshotting
                        workflow.out[0][0].adapter_seq,
                        workflow.out[0][0].meta, // Reads meta map
                        workflow.out[0][0].num_trimmed_reads,
                        workflow.out[0][0].trim?.reads_fail,
                        workflow.out[0][0].trim?.reads_merged,
                        workflow.out[0][0].umi?.log
                    ).match()
                }
            )
        }
    }

