//
// RSEM quantification options
//

process {

    // Per-sample output naming in --skip_quantification_merge mode; overrides the
    // subworkflow's own merged-only default.
    withName: '.*:QUANTIFY_RSEM:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:TXIMETA_TXIMPORT' {
        ext.prefix = { meta.id == 'all_samples' ? "${quant_type}.merged" : meta.id }
    }

    withName: '.*:QUANTIFY_RSEM:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_GENE_UNIFIED' {
        ext.prefix = { "rsem.merged.gene" }
    }

    withName: '.*:QUANTIFY_RSEM:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_TRANSCRIPT_UNIFIED' {
        ext.prefix = { "rsem.merged.transcript" }
    }

    // Distinct from TXIMETA_TXIMPORT's "rsem.merged" prefix above: both produce
    // a *.gene_counts.tsv/*.gene_tpm.tsv/*.transcript_counts.tsv/*.transcript_tpm.tsv
    // set, and routing two same-named files through `>>` from different tasks
    // silently drops one of them (nextflow-io/nextflow#6617).
    withName: '.*:QUANTIFY_RSEM:CUSTOM_RSEMMERGECOUNTS' {
        ext.prefix = { "rsem_merge_counts" }
    }
}
