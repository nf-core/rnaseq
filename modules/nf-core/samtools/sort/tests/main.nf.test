nextflow_process {

    name "Test Process SAMTOOLS_SORT"
    script "../main.nf"
    process "SAMTOOLS_SORT"
    tag "modules"
    tag "modules_nfcore"
    tag "samtools"
    tag "samtools/sort"

    test("bam_no_index") {

        config "./nextflow.config"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    raw_bams: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true)
                ))
                input[1] = channel.of([
                    [ id:'fasta' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)
                ])
                input[2] = ''
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    file(process.out[0][0].bam).name + ':readsMD5,' + bam(process.out[0][0].bam).getReadsMD5(),
                    process.out[0][0].findAll { k, v -> k in ['bai', 'csi', 'crai'] && v }.collect { k, v -> file(v).name }
                ).match() }
            )
        }
    }

