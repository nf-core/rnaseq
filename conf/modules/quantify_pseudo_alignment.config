//
// Pseudo-alignment options
//

process {
    // Covers SALMON_QUANT under both its direct name and its QUANTIFY_BAM_SALMON alias.
    withName: '.*:(QUANTIFY_BAM_SALMON|QUANTIFY_PSEUDO_ALIGNMENT):SALMON_QUANT' {
        ext.args   = {
            def validLibTypes = [ 'A', 'U', 'SF', 'SR', 'IS', 'IU', 'ISF', 'ISR', 'OS', 'OU', 'OSF', 'OSR', 'MS', 'MU', 'MSF', 'MSR' ]
            def libType
            if (params.salmon_quant_libtype) {
                if (validLibTypes.contains(params.salmon_quant_libtype)) {
                    libType = params.salmon_quant_libtype
                }
                else {
                    log.info("[Salmon Quant] Invalid library type specified '--libType=${params.salmon_quant_libtype}', defaulting to auto-detection with '--libType=A'.")
                    libType = 'A'
                }
            }
            else {
                libType = meta.single_end
                    ? (meta.strandedness == 'forward' ? 'SF' : meta.strandedness == 'reverse' ? 'SR' : 'U')
                    : (meta.strandedness == 'forward' ? 'ISF' : meta.strandedness == 'reverse' ? 'ISR' : 'IU')
            }
            [ "--libType=${libType}", params.extra_salmon_quant_args ?: '' ].join(' ').trim()
        }
    }

    withName: '.*:QUANTIFY_PSEUDO_ALIGNMENT:SALMON_QUANT' {
        publishDir = [
            path: { "${params.outdir}/${task.ext.publish_prefix}${params.pseudo_aligner}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('_meta_info.json') || filename.endsWith('_format_counts.json') ? null : filename }
        ]
    }

    withName: '.*:QUANTIFY_PSEUDO_ALIGNMENT:KALLISTO_QUANT' {
        ext.args = {
            def extra = params.extra_kallisto_quant_args ?: ''
            def strandedness = (extra.contains('--fr-stranded') || extra.contains('--rf-stranded')) ? '' :
                meta.strandedness == 'forward' ? '--fr-stranded' :
                meta.strandedness == 'reverse' ? '--rf-stranded' : ''
            [ strandedness, extra ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${task.ext.publish_prefix}${params.pseudo_aligner}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.run_info.json') || filename.endsWith('.log') ? null : filename }
        ]
    }

    withName: '.*:QUANTIFY_PSEUDO_ALIGNMENT:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:(CUSTOM_TX2GENE|TXIMETA_TXIMPORT)' {
        publishDir = [
            path: { "${params.outdir}/${task.ext.publish_prefix}${params.pseudo_aligner}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (params.skip_quantification_merge && filename.endsWith('gene_counts_length_scaled.tsv')) return null
                filename
            }
        ]
    }

    // Per-sample output naming in --skip_quantification_merge mode; overrides the
    // subworkflow's own merged-only default.
    withName: '.*:QUANTIFY_PSEUDO_ALIGNMENT:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:TXIMETA_TXIMPORT' {
        ext.prefix = { meta.id == 'all_samples' ? "${quant_type}.merged" : meta.id }
    }

    withName: '.*:QUANTIFY_PSEUDO_ALIGNMENT:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_.*' {
        publishDir = [
            path: { "${params.outdir}/${task.ext.publish_prefix}${params.pseudo_aligner}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.log') ? null : filename }
        ]
    }

    withName: '.*:QUANTIFY_PSEUDO_ALIGNMENT:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_GENE_UNIFIED' {
        ext.prefix = { "${params.pseudo_aligner}.merged.gene" }
    }

    withName: '.*:QUANTIFY_PSEUDO_ALIGNMENT:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_TRANSCRIPT_UNIFIED' {
        ext.prefix = { "${params.pseudo_aligner}.merged.transcript" }
    }

    withName: 'DESEQ2_QC_PSEUDO' {
        ext.args   = { [
            "--id_col 1",
            "--sample_suffix ''",
            "--count_col 3",
            params.deseq2_vst ? '--vst TRUE' : ''
        ].join(' ').trim() }
        ext.args2  = { params.pseudo_aligner }
        publishDir = [
            path: { "${params.outdir}/${task.ext.publish_prefix}${params.pseudo_aligner}/deseq2_qc" },
            mode: params.publish_dir_mode,
            pattern: "*{RData,pca.vals.txt,plots.pdf,sample.dists.txt,size_factors,log}"
        ]
    }
}
