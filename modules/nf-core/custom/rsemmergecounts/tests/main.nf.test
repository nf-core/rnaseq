nextflow_process {

    name "Test Process CUSTOM_RSEMMERGECOUNTS"
    script "../main.nf"
    process "CUSTOM_RSEMMERGECOUNTS"

    tag "modules"
    tag "modules_nfcore"
    tag "custom"
    tag "custom/rsemmergecounts"
    tag "untar"

    test("saccharomyces_cerevisiae") {

        setup {
            run("UNTAR") {
                script "../../../untar/main.nf"
                process {
                    """
                    input[0] = Channel.of(record(
                        id: 'rsem_results',
                        meta: [ id: 'rsem_results' ],
                        archive: file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/rsem_results.tar.gz', checkIfExists: true)
                    ))
                    """
                }
            }
        }

        when {
            process {
                """
                ch_genes = UNTAR.out.map { r -> [ r.meta, r.dir ] }.flatMap { meta, dir ->
                    def files = []
                    dir.toFile().eachFileRecurse { f ->
                        if (f.name.endsWith('.genes.results')) {
                            files << f.toPath()
                        }
                    }
                    files
                }.collect()
                ch_isoforms = UNTAR.out.map { r -> [ r.meta, r.dir ] }.flatMap { meta, dir ->
                    def files = []
                    dir.toFile().eachFileRecurse { f ->
                        if (f.name.endsWith('.isoforms.results')) {
                            files << f.toPath()
                        }
                    }
                    files
                }.collect()
                input[0] = ch_genes.combine(ch_isoforms).map { genes, isoforms -> record(id: 'rsem_merged', meta: [ id: 'rsem_merged' ], genes: genes, isoforms: isoforms) }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out[0][0].id, process.out[0][0].rsem_merge).match() }
            )
        }
    }

    test("saccharomyces_cerevisiae - stub") {

        options "-stub"

        when {
            process {
                """
                ch_files = Channel.of(
                    file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf', checkIfExists: true)
                ).collect()
                input[0] = ch_files.map { files -> record(id: 'rsem_merged', meta: [ id: 'rsem_merged' ], genes: files, isoforms: files) }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out[0][0].id, process.out[0][0].rsem_merge).match() }
            )
        }
    }
}
