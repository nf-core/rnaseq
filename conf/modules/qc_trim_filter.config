process {

    //
    // FastQC on filtered reads (after BBSplit and/or rRNA removal)
    //

    withName: '.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:FASTQC_FILTERED' {
        ext.args   = '--quiet'
        ext.prefix = { "${sample.meta.id}_filtered" }
    }

    //
    // rRNA FASTA preparation (for SortMeRNA and Bowtie2)
    //

    withName: '.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:SEQKIT_REPLACE' {
        ext.args   = '--pattern "^(.+)" --replacement "{fbn}_\\$1"'
        ext.prefix = { "${sample.meta.id}_prefixed" }
    }

    withName: '.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:SEQKIT_REPLACE_U2T' {
        ext.args   = '--by-seq --pattern "[Uu]" --replacement "T"'
        ext.prefix = { "${sample.meta.id}_converted" }
    }

    //
    // Ribodetector rRNA removal options
    //

    withName: '.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:SEQKIT_STATS' {
        ext.args   = '--all'
        ext.prefix = { "${sample.meta.id}.rrna_removal_stats" }
    }

    withName: '.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:RIBODETECTOR' {
        ext.args         = '-e rrna'
        cpus             = 1
        accelerator      = { sample.gpu ? 1 : null }
        containerOptions = { sample.gpu ? (params.gpu_container_options ?: (workflow.containerEngine in ['singularity', 'apptainer'] ? '--nv' : '--gpus all')) : null }
    }

    //
    // Bowtie2 rRNA removal options
    //

    withName: '.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:BOWTIE2_ALIGN$' {
        ext.args   = '--very-sensitive-local'
        ext.prefix = { "${sample.meta.id}.bowtie2_rrna" }
    }

    withName: '.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:BOWTIE2_ALIGN_PE$' {
        ext.args   = '--very-sensitive-local'
        ext.prefix = { "${sample.meta.id}.bowtie2_rrna" }
    }

    withName: '.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:SAMTOOLS_VIEW_BOWTIE2' {
        ext.prefix = { "${sample.meta.id}.bowtie2_unmapped" }
        ext.args   = '-f 12'  // Keep only pairs where BOTH mates are unmapped
    }

    withName: '.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:SAMTOOLS_FASTQ_BOWTIE2' {
        ext.prefix = { "${sample.meta.id}.bowtie2_filtered" }
    }
}
