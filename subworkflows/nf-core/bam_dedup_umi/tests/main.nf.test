nextflow_workflow {

    name "Test Workflow BAM_DEDUP_UMI"
    script "../main.nf"
    workflow "BAM_DEDUP_UMI"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/bam_dedup_umi"
    tag "subworkflows/bam_dedup_stats_samtools_umicollapse"
    tag "subworkflows/bam_dedup_stats_samtools_umitools"
    tag "subworkflows/bam_sort_stats_samtools"
    tag "umitools/prepareforrsem"
    tag "samtools/sort"

    test("sarscov2_bam_bai - umitools - with transcriptome bams") {

        when {
            workflow {
                """
                input[0] = new nextflow.dataflow.ChannelImpl(channel.of(record(
                    id: 'test',
                    meta: [ id:'test'],
                    bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam.bai', checkIfExists: true),
                    samtools: null,
                    percent_mapped: null,
                    transcriptome_bam: null
                )))
                input[1] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta', checkIfExists: true)))
                input[2] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)))
                input[3] = 'umitools'
                input[4] = false
                input[5] = new nextflow.dataflow.ChannelImpl(channel.of(record(
                    id: 'test',
                    meta: [ id:'test'],
                    bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true),
                    bai: null,
                    samtools: null,
                    percent_mapped: null,
                    transcriptome_bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true)
                )))
                input[6] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)))
                input[7] = false
                input[8] = ''  // index_args
                input[9] = null  // umi_grouping_method
                input[10] = null  // umi_separator
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    bam(workflow.out[0][0].bam).getReadsMD5(),
                    bam(workflow.out[0][0].transcriptome.filtered_bam ?: workflow.out[0][0].transcriptome.sorted_bam).getReadsMD5(),
                    workflow.out[0][0].samtools.stats,
                    workflow.out[0][0].samtools.flagstat,
                    workflow.out[0][0].samtools.idxstats
                ).match() },
                { assert path(workflow.out[0][0].bai).exists() },
                { assert workflow.out[0].size() == 1 },
                { assert workflow.out[0][0].meta == [ id:'test' ] }
            )
        }

    }

    test("sarscov2_bam_bai - umicollapse - no transcriptome bams") {

        when {
            workflow {
                """
                input[0] = new nextflow.dataflow.ChannelImpl(channel.of(record(
                    id: 'test',
                    meta: [ id:'test'],
                    bam: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam.bai', checkIfExists: true),
                    samtools: null,
                    percent_mapped: null,
                    transcriptome_bam: null
                )))
                input[1] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta', checkIfExists: true)))
                input[2] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + '/genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)))
                input[3] = 'umicollapse'
                input[4] = false
                input[5] = new nextflow.dataflow.ChannelImpl(channel.empty())
                input[6] = new nextflow.dataflow.ValueImpl(channel.value(null as Path))
                input[7] = false
                input[8] = ''  // index_args
                input[9] = null  // umi_grouping_method
                input[10] = null  // umi_separator
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    bam(workflow.out[0][0].bam).getReadsMD5(),
                    workflow.out[0][0].samtools.stats,
                    workflow.out[0][0].samtools.flagstat,
                    workflow.out[0][0].samtools.idxstats
                ).match() },
                { assert path(workflow.out[0][0].bai).exists() },
                { assert workflow.out[0].size() == 1 },
                { assert workflow.out[0][0].meta == [ id:'test' ] }
            )
        }
    }
}
