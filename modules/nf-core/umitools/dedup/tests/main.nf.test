nextflow_process {

    name "Test Process UMITOOLS_DEDUP"
    script "../main.nf"
    process "UMITOOLS_DEDUP"

    tag "modules"
    tag "modules_nfcore"
    tag "umitools"
    tag "umitools/dedup"

    test("se - no stats") {
        config "./nextflow.config"

        when {
            process {
                """
                get_output_stats = false

                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    bam: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.single_end.umi.sorted.bam", checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.single_end.umi.sorted.bam.bai", checkIfExists: true)
                )
                input[1] = get_output_stats
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out[0][0].collectEntries { k, v -> [k, v == null ? null : k in ["bam"] ? file(v).name + ':readsMD5,' + bam(v).getReadsMD5() : k in ["log"] ? file(v).name : v] }).match() }
            )
        }
    }

    test("pe - no stats") {
        config "./nextflow.config"

        when {
            process {
                """
                get_output_stats = false

                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    bam: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam", checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam.bai", checkIfExists: true)
                )
                input[1] = get_output_stats
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out[0][0].collectEntries { k, v -> [k, v == null ? null : k in ["bam"] ? file(v).name + ':readsMD5,' + bam(v).getReadsMD5() : k in ["log"] ? file(v).name : v] }).match() }
            )
        }
    }

    test("pe - with stats") {
        config "./nextflow.config"

        when {
            process {
                """
                get_output_stats = true

                input[0] = record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    bam: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam", checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam.bai", checkIfExists: true)
                )
                input[1] = get_output_stats
