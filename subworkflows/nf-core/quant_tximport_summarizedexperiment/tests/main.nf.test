nextflow_workflow {

    name "Test Workflow QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT"
    script "../main.nf"
    config "./nextflow.config"
    workflow "QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/quant_tximport_summarizedexperiment"

    tag "custom/tx2gene"
    tag "tximeta/tximport"
    tag "summarizedexperiment/summarizedexperiment"
    tag "untar"

    test("salmon") {

        setup {
            run("UNTAR") {
                script "../../../../modules/nf-core/untar/main.nf"
                process {
                    """
                    input[0] = channel.of(record(
                        id: 'salmon_results',
                        meta: [ id: 'salmon_results' ],
                        archive: file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/salmon_results.tar.gz', checkIfExists: true)
                    ))
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/samplesheet.csv', checkIfExists: true)))
                input[1] = new nextflow.dataflow.ChannelImpl(UNTAR.out.map { r -> [ r.meta, r.dir ] }.flatMap { meta, dir ->
                    def entries = []
                    dir.toFile().eachDir { d ->
                        entries << record(id: d.name, meta: [ id: d.name ], quants: [ d.toPath() ])
                    }
                    entries
                })
                input[2] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf', checkIfExists: true)))
                input[3] = 'gene_id'
                input[4] = 'gene_name'
                input[5] = 'salmon'
                input[6] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                        file(workflow.out[0][0].merged_gene_rds).name,
                        file(workflow.out[0][0].merged_transcript_rds).name,
                        workflow.out[0][0].counts_gene,
                        workflow.out[0][0].counts_gene_length_scaled,
                        workflow.out[0][0].counts_gene_scaled,
                        workflow.out[0][0].lengths_gene,
                        workflow.out[0][0].lengths_transcript,
                        workflow.out[0][0].tpm_gene,
                        workflow.out[0][0].tpm_transcript,
                        workflow.out[0][0].counts_transcript,
                        workflow.out[0][0].tx2gene,
                        workflow.out[0][0].tx2gene_augmented
                    ).match()
                }
            )
        }
    }

    test("salmon - transcript absent from GTF") {

        setup {
            run("UNTAR") {
                script "../../../../modules/nf-core/untar/main.nf"
                process {
                    """
                    input[0] = channel.of(record(
                        id: 'salmon_results',
                        meta: [ id: 'salmon_results' ],
                        archive: file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/salmon_results.tar.gz', checkIfExists: true)
                    ))
                    """
                }
            }
        }

        when {
            workflow {
                """
                input[0] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/samplesheet.csv', checkIfExists: true)))
                // Append a row for a transcript absent from the GTF to each sample's quant.sf,
                // simulating e.g. a spike-in or a transcript_fasta sequence not derived from the
                // GTF. Regression test for SE_TRANSCRIPT_UNIFIED failing on exactly this case.
                // The copy keeps the original directory basename (tximport derives sample
                // identity from it, not from meta.id) - only the parent changes.
                input[1] = new nextflow.dataflow.ChannelImpl(UNTAR.out.map { r -> [ r.meta, r.dir ] }.flatMap { meta, dir ->
                    def entries = []
                    dir.toFile().eachDir { d ->
                        def copyDir = file("\${workDir}/\${d.name}_orphan/\${d.name}")
                        copyDir.mkdirs()
                        file("\${copyDir}/quant.sf").text = new File(d, 'quant.sf').text + "ORPHAN_TX_FIXTURE\\t500\\t450.000\\t0.000000\\t0.000\\n"
                        entries << record(id: d.name, meta: [ id: d.name ], quants: [ copyDir ])
                    }
                    entries
                })
                input[2] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + 'genomics/eukaryotes/saccharomyces_cerevisiae/genome_gfp.gtf', checkIfExists: true)))
                input[3] = 'gene_id'
                input[4] = 'gene_name'
                input[5] = 'salmon'
                input[6] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Present in transcript-level output (with its identity self-mapping)...
                { assert file(workflow.out[0][0].counts_transcript).text.contains('ORPHAN_TX_FIXTURE') },
                { assert file(workflow.out[0][0].tx2gene_augmented).text.contains('ORPHAN_TX_FIXTURE') },
                // ...but excluded from gene-level output, since it isn't a real gene.
                { assert !file(workflow.out[0][0].counts_gene).text.contains('ORPHAN_TX_FIXTURE') }
            )
        }
    }

