nextflow_process {

    name "Test Process RUSTQC"
    script "../main.nf"
    process "RUSTQC"

    tag "modules"
    tag "modules_nfcore"
    tag "rustqc"

    test("homo_sapiens paired-end [bam]") {

        config './nextflow.config'

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    bam: file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam", checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai", checkIfExists: true)
                ))
                input[1] = channel.of([
                    [ id:'homo_sapiens' ],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.gtf", checkIfExists: true)
                ])
                """
            }
        }

        then {
            def r = process.out[0][0]
            // every Path in the record apart from the aggregate all_files listing
            def leaves
            leaves = { x ->
                x instanceof Map ? x.findAll { k, v -> k != 'meta' && k != 'all_files' }.values().collectMany { v -> leaves(v) } :
                    x instanceof Collection ? x.collectMany { v -> leaves(v) } :
                    x == null ? [] : [x]
            }
            def names = { x -> leaves(x).collect { v -> file(v).name }.sort() }
            def qualimapFiles = []
            file(r.qualimap).eachFileRecurse { f -> if( !f.isDirectory() ) qualimapFiles << f.toString() }
            def uncovered = r.all_files.findAll { v -> !file(v).isDirectory() }.collect { v -> v.toString() } -
                leaves(r).collect { v -> v.toString() } - qualimapFiles
            assertAll(
                { assert process.success },
                { assert snapshot(
                    // reproducible text outputs - full content
                    r.featurecounts.counts,
                    r.featurecounts.summary,
                    r.biotype,
                    r.preseq.lc_extrap,
                    r.rseqc.inferexperiment,
                    r.rseqc.tin.xls,
                    r.rseqc.tin.txt,
                    r.rseqc.innerdistance.summary,
                    r.rseqc.junctionsaturation.summary,

                    // non-reproducible outputs - filenames only
                    names(r.dupradar),
                    names(r.samtools),
                    qualimapFiles.collect { v -> file(v).name }.sort(),
                    names([r.rseqc.bamstat, r.rseqc.readdistribution,
                        r.rseqc.innerdistance.distance, r.rseqc.innerdistance.freq, r.rseqc.innerdistance.mean,
                        r.rseqc.innerdistance.plot, r.rseqc.innerdistance.rscript,
                        r.rseqc.junctionannotation, r.rseqc.junctionsaturation.plot, r.rseqc.junctionsaturation.rscript,
                        r.rseqc.readduplication])
                ).match() },

                // every MultiQC-eligible file RustQC wrote is routed by some record field
                { assert uncovered == [] },

                // content assertions for non-snapshottable outputs
                // samtools flagstat - 5644 total reads
                { assert file(r.samtools.flagstat).text.contains("5644 + 0 in total") },
                // samtools idxstats - 5642 reads on chr22
                { assert file(r.samtools.idxstats).text.contains("chr22\t40001\t5642") },
                // qualimap - 5,642 alignments, 23.55% exonic
                { assert qualimapFiles.any { v ->
                    v.endsWith("rnaseq_qc_results.txt") &&
                    file(v).text.contains("total alignments = 5,642") &&
                    file(v).text.contains("exonic =  1,328 (23.55%)")
                } },
                // dupradar - 664 reads for ENSG00000239435
                { assert file(r.dupradar.dupmatrix).text.contains("ENSG00000239435\t3389\t664") }
            )
        }
    }

    test("homo_sapiens paired-end [bam] - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    bam: file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam", checkIfExists: true),
                    bai: file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai", checkIfExists: true)
                ))
                input[1] = channel.of([
                    [ id:'homo_sapiens' ],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.gtf", checkIfExists: true)
                ])
                """
            }
        }

        then {
            def r = process.out[0][0]
            // every Path in the record apart from the aggregate all_files listing
            def leaves
            leaves = { x ->
                x instanceof Map ? x.findAll { k, v -> k != 'meta' && k != 'all_files' }.values().collectMany { v -> leaves(v) } :
                    x instanceof Collection ? x.collectMany { v -> leaves(v) } :
                    x == null ? [] : [x]
            }
            def names = { x -> leaves(x).collect { v -> file(v).name }.sort() }
            def qualimapFiles = []
            file(r.qualimap).eachFileRecurse { f -> if( !f.isDirectory() ) qualimapFiles << f.toString() }
            def uncovered = r.all_files.findAll { v -> !file(v).isDirectory() }.collect { v -> v.toString() } -
                leaves(r).collect { v -> v.toString() } - qualimapFiles
            assertAll(
                { assert process.success },
                { assert snapshot(names(r)).match() },
                { assert uncovered == [] }
            )
        }
    }
}
