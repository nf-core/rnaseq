nextflow_process {

    name "Test Process KALLISTO_QUANT"
    script "../main.nf"
    process "KALLISTO_QUANT"
    tag "modules"
    tag "modules_nfcore"
    tag "kallisto"
    tag "kallisto/quant"
    tag "kallisto/index"

    setup {
            run("KALLISTO_INDEX") {
                script "../../index/main.nf"
                process {
                    """
                    input[0] = channel.of(record(
                        id: 'transcriptome',
                        meta: [ id:'transcriptome' ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                    ))
                    """
                }
            }

            run("KALLISTO_INDEX", alias: "KALLISTO_INDEX_STUB") {
                script "../../index/main.nf"
                process {
                    """
                    input[0] = channel.of(record(
                        id: 'transcriptome',
                        meta: [ id:'transcriptome' ],
                        fasta: file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true)
                    ))
                    """
                }
            }
        }

    test("sarscov2 single-end") {
        when {
            process {
                """
                fragment_length    = 150
                fragment_length_sd = 75

                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    reads: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ))
                input[1] = KALLISTO_INDEX.out.map { r -> [ r.meta, r.index ] }.combine(channel.of([ null, null ]))
                input[2] = fragment_length
                input[3] = fragment_length_sd
                """
            }
        }

        then {
            def q = process.out[0][0]
            def quant_files = []
            new File(q.quant_dir.toString()).eachFileRecurse(groovy.io.FileType.FILES) { f -> quant_files << f.name }
            assertAll(
                { assert process.success },
                { assert snapshot(q.id, q.meta, quant_files.sort(), q.json_info ? new File(q.json_info.toString()).name : null, q.log).match() }
            )
        }
    }

    test("sarscov2 paired-end") {
        when {
            process {
                """
                fragment_length    = []
                fragment_length_sd = []

                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    reads: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true), file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ))
                input[1] = KALLISTO_INDEX.out.map { r -> [ r.meta, r.index ] }.combine(channel.of([ null, null ]))
                input[2] = fragment_length
                input[3] = fragment_length_sd
                """
            }
        }
        then {
            def q = process.out[0][0]
            def quant_files = []
            new File(q.quant_dir.toString()).eachFileRecurse(groovy.io.FileType.FILES) { f -> quant_files << f.name }
            assertAll(
                { assert process.success },
                { assert snapshot(q.id, q.meta, quant_files.sort(), q.json_info ? new File(q.json_info.toString()).name : null, q.log).match() }
            )
        }
    }

    test("sarscov2 single-end ext.args sets strandedness") {
        config "./nextflow_ext_args_strandedness.config"

        when {
            process {
                """
                fragment_length    = 150
                fragment_length_sd = 75

                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    reads: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ))
                input[1] = KALLISTO_INDEX.out.map { r -> [ r.meta, r.index ] }.combine(channel.of([ null, null ]))
                input[2] = fragment_length
                input[3] = fragment_length_sd
                """
            }
        }

        then {
            def q = process.out[0][0]
            def quant_files = []
            new File(q.quant_dir.toString()).eachFileRecurse(groovy.io.FileType.FILES) { f -> quant_files << f.name }
            assertAll(
                { assert process.success },
                { assert path(q.json_info).json.call.contains('--fr-stranded') },
                { assert snapshot(q.id, q.meta, quant_files.sort(), q.json_info ? new File(q.json_info.toString()).name : null, q.log).match() }
            )
        }
    }

    test("sarscov2 single-end - stub") {

        options "-stub"

        when {
            process {
                """
                fragment_length    = 150
                fragment_length_sd = 75

                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    reads: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ))
                input[1] = KALLISTO_INDEX_STUB.out.map { r -> [ r.meta, r.index ] }.combine(channel.of([ null, null ]))
                input[2] = fragment_length
                input[3] = fragment_length_sd
                """
            }
        }

        then {
            def q = process.out[0][0]
            def quant_files = []
            new File(q.quant_dir.toString()).eachFileRecurse(groovy.io.FileType.FILES) { f -> quant_files << f.name }
            assertAll(
                { assert process.success },
                { assert snapshot(q.id, q.meta, quant_files.sort(), q.json_info ? new File(q.json_info.toString()).name : null, q.log).match() }
            )
        }
    }

    test("sarscov2 paired-end - stub") {

        options "-stub"

        when {
            process {
                """
                fragment_length    = []
                fragment_length_sd = []

                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    reads: [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true), file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ))
                input[1] = KALLISTO_INDEX_STUB.out.map { r -> [ r.meta, r.index ] }.combine(channel.of([ null, null ]))
                input[2] = fragment_length
                input[3] = fragment_length_sd
                """
            }
        }
        then {
            def q = process.out[0][0]
            def quant_files = []
            new File(q.quant_dir.toString()).eachFileRecurse(groovy.io.FileType.FILES) { f -> quant_files << f.name }
            assertAll(
                { assert process.success },
                { assert snapshot(q.id, q.meta, quant_files.sort(), q.json_info ? new File(q.json_info.toString()).name : null, q.log).match() }
            )
        }
    }
}
