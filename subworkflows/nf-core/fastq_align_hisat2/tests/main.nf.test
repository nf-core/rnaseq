nextflow_workflow {

    name "Test Subworkflow FASTQ_ALIGN_HISAT2"
    script "../main.nf"
    workflow "FASTQ_ALIGN_HISAT2"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/fastq_align_hisat2"

    tag "hisat2/align"
    tag "hisat2/build"
    tag "hisat2/extractsplicesites"

    tag "samtools/flagstat"
    tag "samtools/idxstats"
    tag "samtools/index"
    tag "samtools/sort"
    tag "samtools/stats"
    tag "subworkflows/bam_sort_stats_samtools"

        setup {
            run("HISAT2_EXTRACTSPLICESITES") {
                script "../../../../modules/nf-core/hisat2/extractsplicesites/main.nf"
                process {
                    """
                    input[0] = channel.of(record(
                        id: 'test',
                        meta: [id: 'test'],
                        gtf: file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gtf", checkIfExists: true)
                    ))
                    """
                }
            }

            run("HISAT2_EXTRACTSPLICESITES", alias: "HISAT2_EXTRACTSPLICESITES_STUB") {
                script "../../../../modules/nf-core/hisat2/extractsplicesites/main.nf"
                process {
                    """
                    input[0] = channel.of(record(
                        id: 'test',
                        meta: [id: 'test'],
                        gtf: file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gtf", checkIfExists: true)
                    ))
                    """
                }
            }

            run("HISAT2_BUILD") {
                script "../../../../modules/nf-core/hisat2/build/main.nf"
                process {
                    """
                    input[0] = HISAT2_EXTRACTSPLICESITES.out.map { r ->
                        record(
                            id: r.id,
                            meta: r.meta,
                            fasta: file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true),
                            gtf: file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gtf", checkIfExists: true),
                            splicesites: r.splicesites
                        )}
                    input[1] = false
                    """
                }
            }

            run("HISAT2_BUILD", alias: "HISAT2_BUILD_STUB") {
                script "../../../../modules/nf-core/hisat2/build/main.nf"
                process {
                    """
                    input[0] = HISAT2_EXTRACTSPLICESITES_STUB.out.map { r ->
                        record(
                            id: r.id,
                            meta: r.meta,
                            fasta: file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true),
                            gtf: file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gtf", checkIfExists: true),
                            splicesites: r.splicesites
                        )}
                    input[1] = false
                    """
                }
            }
        }

    test("sarscov2 - bam - single_end") {

        when {
            workflow {
                """
                input[0] = new nextflow.dataflow.ChannelImpl(channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    reads: [
                        file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz", checkIfExists: true)
                        ]
                )))
                input[1] = new nextflow.dataflow.ValueImpl(HISAT2_BUILD.out.map { r -> r.index }.first())
                input[2] = new nextflow.dataflow.ValueImpl(HISAT2_EXTRACTSPLICESITES.out.map { r -> r.splicesites }.first())
                input[3] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true)))
                input[4] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta.fai", checkIfExists: true)))
                input[5] = false
                input[6] = ''  // index_args
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(sanitizeOutput(workflow.out, readsMD5Keys: ["bam"], unstableKeys: ["bai", "raw_bams"])).match()}
            )
        }
    }
    test("sarscov2 - bam - paired_end") {

        when {
            workflow {
                """
                input[0] = new nextflow.dataflow.ChannelImpl(channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    reads: [
                        file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_2.fastq.gz", checkIfExists: true)
                        ]
                )))
                input[1] = new nextflow.dataflow.ValueImpl(HISAT2_BUILD.out.map { r -> r.index }.first())
                input[2] = new nextflow.dataflow.ValueImpl(HISAT2_EXTRACTSPLICESITES.out.map { r -> r.splicesites }.first())
                input[3] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true)))
                input[4] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta.fai", checkIfExists: true)))
                input[5] = false
                input[6] = ''  // index_args
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(sanitizeOutput(workflow.out, readsMD5Keys: ["bam"], unstableKeys: ["bai", "raw_bams"])).match()}
            )
        }
    }

    test("sarscov2 - bam - single_end - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = new nextflow.dataflow.ChannelImpl(channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:true ],
                    reads: [ file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz", checkIfExists: true) ]
                )))
                input[1] = new nextflow.dataflow.ValueImpl(HISAT2_BUILD_STUB.out.map { r -> r.index }.first())
                input[2] = new nextflow.dataflow.ValueImpl(HISAT2_EXTRACTSPLICESITES_STUB.out.map { r -> r.splicesites }.first())
                input[3] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true)))
                input[4] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta.fai", checkIfExists: true)))
                input[5] = false
                input[6] = ''  // index_args
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(sanitizeOutput(workflow.out)).match()}
            )
        }
    }
    test("sarscov2 - bam - paired_end - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = new nextflow.dataflow.ChannelImpl(channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end:false ],
                    reads: [
                        file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_2.fastq.gz", checkIfExists: true)
                        ]
                )))
                input[1] = new nextflow.dataflow.ValueImpl(HISAT2_BUILD_STUB.out.map { r -> r.index }.first())
                input[2] = new nextflow.dataflow.ValueImpl(HISAT2_EXTRACTSPLICESITES_STUB.out.map { r -> r.splicesites }.first())
                input[3] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta", checkIfExists: true)))
                input[4] = new nextflow.dataflow.ValueImpl(channel.value(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.fasta.fai", checkIfExists: true)))
                input[5] = false
                input[6] = ''  // index_args
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(sanitizeOutput(workflow.out)).match()}
            )
        }
    }
}
