process {
    withName: 'SAMTOOLS_SORT_QUALIMAP' {
        ext.args = '-n'
        ext.prefix = { "${sample.meta.id}.namesorted" }
    }

    withName: 'QUALIMAP_RNASEQ' {
        ext.args = { [
            '--sorted',
            sample.meta.strandedness == 'forward' ? '-p strand-specific-forward' :
                sample.meta.strandedness == 'reverse' ? '-p strand-specific-reverse' :
                '-p non-strand-specific'
        ].join(' ') }
    }
}
