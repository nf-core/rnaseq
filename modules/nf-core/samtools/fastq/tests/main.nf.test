nextflow_process {

    name "Test Process SAMTOOLS_FASTQ"
    script "../main.nf"
    process "SAMTOOLS_FASTQ"

    tag "modules"
    tag "modules_nfcore"
    tag "samtools"
    tag "samtools/fastq"

    test("bam") {

        when {
            process {
                """
                interleave = false

                input[0] = channel.of([
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true)
                ])
                input[1] = interleave
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out[0][0].fastq.collect { path(it).linesGzip[0..6] }).match("bam_fastq") },
                { assert snapshot(process.out[0][0].interleaved).match("bam_interleaved") },
                { assert snapshot(file(process.out[0][0].singleton).name).match("bam_singleton") },
                { assert snapshot(file(process.out[0][0].other).name).match("bam_other") }
            )
        }
    }

    test("bam_interleave") {

        when {
            process {
                """
                interleave = true

                input[0] = channel.of([
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true)
                ])
                input[1] = interleave
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out[0][0].fastq).match("bam_interleave_fastq") },
                { assert snapshot(path(process.out[0][0].interleaved).readLines()[0..6]).match("bam_interlinterleave_eaved") },
                { assert snapshot(process.out[0][0].singleton).match("bam_singinterleave_leton") },
                { assert snapshot(file(process.out[0][0].other).name).match("bam_interleave_other") }
            )
        }
    }

    test("bam - stub") {

        options "-stub"

        when {
            process {
                """
                interleave = false

                input[0] = channel.of([
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true)
                ])
                input[1] = interleave
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out[0][0].fastq,
                    process.out[0][0].interleaved,
                    process.out[0][0].singleton,
                    process.out[0][0].other
                ).match() }
            )
        }
    }

    test("bam_interleave - stub") {

        options "-stub"

        when {
            process {
                """
                interleave = true

                input[0] = channel.of([
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true)
                ])
                input[1] = interleave
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out[0][0].fastq,
                    process.out[0][0].interleaved,
                    process.out[0][0].singleton,
                    process.out[0][0].other
                ).match() }
            )
        }
    }
}
