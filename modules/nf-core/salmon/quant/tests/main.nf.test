nextflow_process {

    name "Test Process SALMON_QUANT"
    script "../main.nf"
    process "SALMON_QUANT"
    tag "modules"
    tag "modules_nfcore"
    tag "salmon"
    tag "salmon/quant"
    tag "salmon/index"

    setup {
        run("SALMON_INDEX") {
            script "../../../salmon/index/main.nf"
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test' ],
                    transcript_fasta: file(params.modules_testdata_base_path + "genomics/sarscov2/genome/transcriptome.fasta", checkIfExists: true),
                    genome_fasta: file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.fasta", checkIfExists: true)
                ))
                """
            }
        }
    }

    test("sarscov2 - single_end") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end: true ],
                    reads: [ file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz", checkIfExists: true) ]
                ))
                input[1] = SALMON_INDEX.out.map { r -> r.index }
                input[2] = channel.of(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gtf", checkIfExists: true))
                input[3] = channel.of(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/transcriptome.fasta", checkIfExists: true))
                """
            }
        }

        then {
            def q = process.out[0][0]
            def quant_files = []
            new File(q.quant_dir.toString()).eachFileRecurse(groovy.io.FileType.FILES) { f -> quant_files << f.name }
            assertAll(
                { assert process.success },
                { assert snapshot(q.id, q.meta, quant_files.sort(), q.json_info ? new File(q.json_info.toString()).name : null, q.lib_format_counts).match() }
            )
        }

    }

    test("sarscov2 - single_end stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'test',
                    meta: [ id:'test', single_end: true ],
                    reads: [ file(params.modules_testdata_base_path + "genomics/sarscov2/illumina/fastq/test_1.fastq.gz", checkIfExists: true) ]
                ))
                input[1] = SALMON_INDEX.out.map { r -> r.index }
                input[2] = channel.of(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/genome.gtf", checkIfExists: true))
                input[3] = channel.of(file(params.modules_testdata_base_path + "genomics/sarscov2/genome/transcriptome.fasta", checkIfExists: true))
                """
            }
        }

        then {
            def q = process.out[0][0]
            def quant_files = []
            new File(q.quant_dir.toString()).eachFileRecurse(groovy.io.FileType.FILES) { f -> quant_files << f.name }
            assertAll(
                { assert process.success },
                { assert snapshot(q.id, q.meta, quant_files.sort(), q.json_info ? new File(q.json_info.toString()).name : null, q.lib_format_counts).match() }
            )
        }

    }

    test("sarscov2 - single_end multiple files") {

